@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "behavioral.domain.model.aggregates" {
  class BehavioralProgress {
    - id: BehavioralProgressId
    - userId: UUID
    - adherenceStatus: AdherenceStatus
    - streak: int
    - consecutiveMisses: int
    - lastGoalMetDate: LocalDate
    - goalMetDates: List<LocalDate>
    - updatedAt: Instant
    + BehavioralProgress(userId: UUID)
    + markGoalMet(date: LocalDate): void
    + markGoalMissed(): void
    + recalculateAdherenceStatus(): void
    + registerStreakMilestone(): void
    + isOnTrack(): boolean
    + needsReEngagement(): boolean
    + getWeeklyCompletionRate(): double
    + getId(): BehavioralProgressId
  }
  class RecoveryPlan {
    - id: RecoveryPlanId
    - userId: UUID
    - trigger: AdherenceDropTrigger
    - status: RecoveryPlanStatus
    - actions: List<RecoveryAction>
    - activatedAt: Instant
    - resolvedAt: Instant
    + RecoveryPlan(userId: UUID, trigger: AdherenceDropTrigger)
    + complete(): void
    + expire(): void
    + isActive(): boolean
    + getId(): RecoveryPlanId
  }
}

package "behavioral.domain.model.entities" {
  class EatingBehaviorPattern {
    - id: EatingBehaviorPatternId
    - userId: UUID
    - patternType: BehaviorPatternType
    - weeklyCompletionRate: double
    - currentStreak: int
    - consecutiveMisses: int
    - analyzedAt: Instant
    + EatingBehaviorPattern(userId: UUID)
    + analyze(progress: BehavioralProgress): void
    + isImproving(): boolean
    + isDeclining(): boolean
    + getId(): EatingBehaviorPatternId
  }
}

package "behavioral.domain.model.valueobjects" {
  class BehavioralProgressId <<ValueObject>> {
    - value: UUID
    + getValue(): UUID
  }
  class RecoveryPlanId <<ValueObject>> {
    - value: UUID
    + getValue(): UUID
  }
  class EatingBehaviorPatternId <<ValueObject>> {
    - value: UUID
    + getValue(): UUID
  }
  class RecoveryAction <<ValueObject>> {
    - type: RecoveryActionType
    - descriptionKey: String
    - priority: int
    + RecoveryAction(type: RecoveryActionType, priority: int)
    + getType(): RecoveryActionType
    + getPriority(): int
  }
}

package "behavioral.domain.model.enums" {
  enum AdherenceStatus {
    ON_TRACK
    AT_RISK
    DROPPED
  }
  enum AdherenceDropTrigger {
    STRATEGY_MISMATCH
    BEHAVIORAL_DROP
    NUTRITIONAL_ABANDONMENT
  }
  enum BehaviorPatternType {
    CONSISTENT
    WEEKDAY_ONLY
    RECOVERING
    IRREGULAR
  }
  enum RecoveryActionType {
    REDUCE_CALORIE_TARGET
    FOCUS_SINGLE_MEAL
    SIMPLIFY_TRACKING
    LOG_ANY_MEAL
  }
  enum RecoveryPlanStatus {
    ACTIVE
    COMPLETED
    EXPIRED
  }
}

package "behavioral.domain.model.events" {
  class BehaviorPatternAnalyzed <<DomainEvent>> {
    + userId: UUID
    + patternType: String
    + analyzedAt: Instant
    + occurredOn: Instant
  }
  class BehavioralDropDetected <<DomainEvent>> {
    + userId: UUID
    + consecutiveMisses: int
    + occurredOn: Instant
  }
  class NutritionalAbandonmentRisk <<DomainEvent>> {
    + userId: UUID
    + daysDropped: int
    + occurredOn: Instant
  }
  class ConsistencyRecovered <<DomainEvent>> {
    + userId: UUID
    + occurredOn: Instant
  }
  class StreakMilestoneReached <<DomainEvent>> {
    + userId: UUID
    + milestone: int
    + occurredOn: Instant
  }
  class RecoveryPlanActivated <<DomainEvent>> {
    + userId: UUID
    + planId: UUID
    + trigger: String
    + occurredOn: Instant
  }
  class RecoveryPlanCompleted <<DomainEvent>> {
    + userId: UUID
    + planId: UUID
    + occurredOn: Instant
  }
  class StrategyMismatchDetected <<DomainEvent>> {
    + userId: UUID
    + occurredOn: Instant
  }
}

package "behavioral.domain.repositories" {
  interface BehavioralProgressRepository {
    + findByUserId(userId: UUID): Optional<BehavioralProgress>
    + save(progress: BehavioralProgress): BehavioralProgress
  }
  interface RecoveryPlanRepository {
    + findActiveByUserId(userId: UUID): Optional<RecoveryPlan>
    + findByUserId(userId: UUID): List<RecoveryPlan>
    + save(plan: RecoveryPlan): RecoveryPlan
  }
  interface EatingBehaviorPatternRepository {
    + findByUserId(userId: UUID): Optional<EatingBehaviorPattern>
    + save(pattern: EatingBehaviorPattern): EatingBehaviorPattern
  }
}

package "behavioral.application.internal.commandservices" {
  class BehavioralCommandService {
    - progressRepository: BehavioralProgressRepository
    - recoveryPlanRepository: RecoveryPlanRepository
    - patternRepository: EatingBehaviorPatternRepository
    + handle(command: InitializeBehavioralTrackingCommand): BehavioralProgress
    + handle(command: EvaluateAdherenceStatusCommand): BehavioralProgress
    + handle(command: DetectBehavioralDropCommand): RecoveryPlan
    + handle(command: EscalateAbandonmentRiskCommand): RecoveryPlan
    + handle(command: RegisterConsistencyRecoveryCommand): BehavioralProgress
    + handle(command: RegisterStreakMilestoneCommand): BehavioralProgress
    + handle(command: AnalyzeEatingPatternCommand): EatingBehaviorPattern
    + handle(command: EvaluateStrategyConsistencyCommand): void
  }
  class InitializeBehavioralTrackingCommand <<Command>> {
    + userId: UUID
  }
  class EvaluateAdherenceStatusCommand <<Command>> {
    + userId: UUID
    + date: LocalDate
    + goalMet: boolean
  }
  class DetectBehavioralDropCommand <<Command>> {
    + userId: UUID
  }
  class EscalateAbandonmentRiskCommand <<Command>> {
    + userId: UUID
  }
  class RegisterConsistencyRecoveryCommand <<Command>> {
    + userId: UUID
  }
  class RegisterStreakMilestoneCommand <<Command>> {
    + userId: UUID
    + milestone: int
  }
  class AnalyzeEatingPatternCommand <<Command>> {
    + userId: UUID
  }
  class EvaluateStrategyConsistencyCommand <<Command>> {
    + userId: UUID
    + newDailyCalorieTarget: double
  }
}

package "behavioral.application.internal.queryservices" {
  class BehavioralQueryService {
    - progressRepository: BehavioralProgressRepository
    - recoveryPlanRepository: RecoveryPlanRepository
    - patternRepository: EatingBehaviorPatternRepository
    + handle(query: GetBehavioralProgressQuery): Optional<BehavioralProgress>
    + handle(query: GetActiveRecoveryPlanQuery): Optional<RecoveryPlan>
    + handle(query: GetEatingBehaviorPatternQuery): Optional<EatingBehaviorPattern>
  }
  class GetBehavioralProgressQuery <<Query>> {
    + userId: UUID
  }
  class GetActiveRecoveryPlanQuery <<Query>> {
    + userId: UUID
  }
  class GetEatingBehaviorPatternQuery <<Query>> {
    + userId: UUID
  }
}

package "behavioral.interfaces.rest.resources" {
  class BehavioralProgressResource {
    + userId: UUID
    + adherenceStatus: String
    + streak: int
    + consecutiveMisses: int
    + weeklyCompletionRate: double
    + lastGoalMetDate: String
  }
  class RecoveryActionResource {
    + type: String
    + descriptionKey: String
    + priority: int
  }
  class RecoveryPlanResource {
    + id: UUID
    + trigger: String
    + status: String
    + actions: List<RecoveryActionResource>
    + activatedAt: String
    + resolvedAt: String
  }
  class EatingBehaviorPatternResource {
    + userId: UUID
    + patternType: String
    + weeklyCompletionRate: double
    + currentStreak: int
    + consecutiveMisses: int
    + analyzedAt: String
  }
}

package "behavioral.interfaces.rest.assemblers" {
  class BehavioralProgressAssembler {
    + toResourceFromEntity(progress: BehavioralProgress): BehavioralProgressResource
  }
  class RecoveryPlanAssembler {
    + toResourceFromEntity(plan: RecoveryPlan): RecoveryPlanResource
    + toActionResource(action: RecoveryAction): RecoveryActionResource
  }
  class EatingBehaviorPatternAssembler {
    + toResourceFromEntity(pattern: EatingBehaviorPattern): EatingBehaviorPatternResource
  }
}

package "behavioral.interfaces.rest.controllers" {
  class BehavioralConsistencyController {
    - commandService: BehavioralCommandService
    - queryService: BehavioralQueryService
    + getProgress(userId: UUID): ResponseEntity<BehavioralProgressResource>
    + evaluateAdherence(userId: UUID, date: LocalDate, goalMet: boolean): ResponseEntity<BehavioralProgressResource>
    + getActiveRecoveryPlan(userId: UUID): ResponseEntity<RecoveryPlanResource>
    + getEatingPattern(userId: UUID): ResponseEntity<EatingBehaviorPatternResource>
    + analyzePattern(userId: UUID): ResponseEntity<EatingBehaviorPatternResource>
  }
}

BehavioralProgress "1" *--> "1" AdherenceStatus : has >
BehavioralProgress "1" *--> "1" BehavioralProgressId : identified by >
RecoveryPlan "1" *--> "1..*" RecoveryAction : prescribes >
RecoveryPlan "1" *--> "1" AdherenceDropTrigger : triggered by >
RecoveryPlan "1" *--> "1" RecoveryPlanStatus : has >
RecoveryAction "1" *--> "1" RecoveryActionType : typed as >
EatingBehaviorPattern "1" *--> "1" BehaviorPatternType : classified as >
EatingBehaviorPattern ..> BehavioralProgress : derived from >

BehavioralProgress ..> BehavioralDropDetected : publishes >
BehavioralProgress ..> NutritionalAbandonmentRisk : publishes >
BehavioralProgress ..> ConsistencyRecovered : publishes >
BehavioralProgress ..> StreakMilestoneReached : publishes >
BehavioralProgress ..> StrategyMismatchDetected : publishes >
RecoveryPlan ..> RecoveryPlanActivated : publishes >
RecoveryPlan ..> RecoveryPlanCompleted : publishes >
EatingBehaviorPattern ..> BehaviorPatternAnalyzed : publishes >

BehavioralCommandService --> BehavioralProgressRepository : uses >
BehavioralCommandService --> RecoveryPlanRepository : uses >
BehavioralCommandService --> EatingBehaviorPatternRepository : uses >
BehavioralQueryService --> BehavioralProgressRepository : uses >
BehavioralQueryService --> RecoveryPlanRepository : uses >
BehavioralQueryService --> EatingBehaviorPatternRepository : uses >

BehavioralConsistencyController --> BehavioralCommandService : uses >
BehavioralConsistencyController --> BehavioralQueryService : uses >
BehavioralConsistencyController --> BehavioralProgressAssembler : uses >
BehavioralConsistencyController --> RecoveryPlanAssembler : uses >
BehavioralConsistencyController --> EatingBehaviorPatternAssembler : uses >

@enduml