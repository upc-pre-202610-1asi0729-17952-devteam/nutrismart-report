@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "iam.domain.model.aggregates" {
  class User {
    - id: UserId
    - email: Email
    - passwordHash: PasswordHash
    - profile: UserProfile
    - role: UserRole
    - createdAt: Instant
    - updatedAt: Instant
    + User(email: Email, passwordHash: PasswordHash, role: UserRole)
    + updateProfile(profile: UserProfile): void
    + changePassword(newHash: PasswordHash): void
    + getId(): UserId
    + getEmail(): Email
    + getRole(): UserRole
    + getProfile(): UserProfile
  }
}

package "iam.domain.model.valueobjects" {
  class UserId <<ValueObject>> {
    - value: UUID
    + UserId(value: UUID)
    + getValue(): UUID
  }
  class Email <<ValueObject>> {
    - value: String
    + Email(value: String)
    + getValue(): String
    + isValid(): boolean
  }
  class PasswordHash <<ValueObject>> {
    - hash: String
    + PasswordHash(hash: String)
    + getHash(): String
  }
  class UserProfile <<ValueObject>> {
    - firstName: String
    - lastName: String
    - avatarUrl: String
    - weightKg: double
    - heightCm: double
    - birthDate: LocalDate
    - biologicalSex: String
    - activityLevel: String
    - goal: String
    - dietaryRestrictions: List<String>
    + UserProfile(firstName: String, lastName: String)
    + getFullName(): String
    + getAvatarUrl(): String
  }
}

package "iam.domain.model.enums" {
  enum UserRole {
    USER
    ADMIN
  }
}

package "iam.domain.model.events" {
  class AccountCreated <<DomainEvent>> {
    + userId: UUID
    + email: String
    + occurredOn: Instant
  }
  class OnboardingCompleted <<DomainEvent>> {
    + userId: UUID
    + weightKg: double
    + heightCm: double
    + goal: String
    + activityLevel: String
    + dietaryRestrictions: List<String>
    + occurredOn: Instant
  }
  class SessionStarted <<DomainEvent>> {
    + userId: UUID
    + occurredOn: Instant
  }
  class ProfileUpdated <<DomainEvent>> {
    + userId: UUID
    + activityLevelChanged: boolean
    + occurredOn: Instant
  }
}

package "iam.domain.services" {
  interface UserDomainService {
    + hashPassword(raw: String): PasswordHash
    + validateCredentials(email: Email, raw: String, hash: PasswordHash): boolean
  }
}

package "iam.domain.repositories" {
  interface UserRepository {
    + findById(id: UserId): Optional<User>
    + findByEmail(email: Email): Optional<User>
    + save(user: User): User
    + existsByEmail(email: Email): boolean
  }
}

package "iam.application.internal.commandservices" {
  class UserCommandService {
    - userRepository: UserRepository
    - userDomainService: UserDomainService
    + handle(command: RegisterAccountCommand): User
    + handle(command: SubmitOnboardingProfileCommand): User
    + handle(command: UpdateProfileCommand): User
    + handle(command: ChangePasswordCommand): void
  }
  class RegisterAccountCommand <<Command>> {
    + email: String
    + password: String
    + firstName: String
    + lastName: String
  }
  class SubmitOnboardingProfileCommand <<Command>> {
    + userId: UUID
    + weightKg: double
    + heightCm: double
    + birthDate: LocalDate
    + biologicalSex: String
    + activityLevel: String
    + goal: String
    + dietaryRestrictions: List<String>
  }
  class UpdateProfileCommand <<Command>> {
    + userId: UUID
    + firstName: String
    + lastName: String
    + avatarUrl: String
    + activityLevel: String
  }
  class ChangePasswordCommand <<Command>> {
    + userId: UUID
    + currentPassword: String
    + newPassword: String
  }
}

package "iam.application.internal.queryservices" {
  class UserQueryService {
    - userRepository: UserRepository
    + handle(query: GetUserByIdQuery): Optional<User>
    + handle(query: GetUserByEmailQuery): Optional<User>
  }
  class GetUserByIdQuery <<Query>> {
    + userId: UUID
  }
  class GetUserByEmailQuery <<Query>> {
    + email: String
  }
}

package "iam.infrastructure.persistence.jpa" {
  class UserRepositoryImpl {
    - jpaRepository: UserJpaRepository
    + findById(id: UserId): Optional<User>
    + findByEmail(email: Email): Optional<User>
    + save(user: User): User
    + existsByEmail(email: Email): boolean
  }
}

package "iam.infrastructure.tokens" {
  class JwtTokenProvider {
    - secret: String
    - expirationMs: long
    + generateToken(userId: UUID, role: String): String
    + validateToken(token: String): boolean
    + getUserIdFromToken(token: String): UUID
  }
}

package "iam.interfaces.rest.resources" {
  class RegisterAccountResource {
    + email: String
    + password: String
    + firstName: String
    + lastName: String
  }
  class OnboardingProfileResource {
    + weightKg: double
    + heightCm: double
    + birthDate: String
    + biologicalSex: String
    + activityLevel: String
    + goal: String
    + dietaryRestrictions: List<String>
  }
  class AuthenticateUserResource {
    + email: String
    + password: String
  }
  class UpdateProfileResource {
    + firstName: String
    + lastName: String
    + avatarUrl: String
    + activityLevel: String
  }
  class UserProfileResource {
    + id: UUID
    + email: String
    + fullName: String
    + role: String
    + avatarUrl: String
    + goal: String
    + activityLevel: String
  }
  class AuthTokenResource {
    + token: String
    + userId: UUID
    + role: String
  }
}

package "iam.interfaces.rest.assemblers" {
  class UserResourceAssembler {
    + toResourceFromEntity(user: User): UserProfileResource
  }
}

package "iam.interfaces.rest.controllers" {
  class AuthController {
    - commandService: UserCommandService
    - queryService: UserQueryService
    - jwtTokenProvider: JwtTokenProvider
    + register(resource: RegisterAccountResource): ResponseEntity<UserProfileResource>
    + authenticate(resource: AuthenticateUserResource): ResponseEntity<AuthTokenResource>
  }
  class UserController {
    - commandService: UserCommandService
    - queryService: UserQueryService
    + getProfile(userId: UUID): ResponseEntity<UserProfileResource>
    + submitOnboarding(userId: UUID, resource: OnboardingProfileResource): ResponseEntity<UserProfileResource>
    + updateProfile(userId: UUID, resource: UpdateProfileResource): ResponseEntity<UserProfileResource>
    + changePassword(userId: UUID, resource: ChangePasswordCommand): ResponseEntity<Void>
  }
}

User "1" *--> "1" UserId : identified by >
User "1" *--> "1" Email : has >
User "1" *--> "1" PasswordHash : has >
User "1" *--> "1" UserProfile : has >
User "1" *--> "1" UserRole : has >
User ..> AccountCreated : publishes >
User ..> OnboardingCompleted : publishes >
User ..> SessionStarted : publishes >
User ..> ProfileUpdated : publishes >

UserRepositoryImpl ..|> UserRepository : implements
UserCommandService --> UserRepository : uses >
UserCommandService --> UserDomainService : uses >
UserQueryService --> UserRepository : uses >

AuthController --> UserCommandService : uses >
AuthController --> UserQueryService : uses >
AuthController --> JwtTokenProvider : uses >
UserController --> UserCommandService : uses >
UserController --> UserQueryService : uses >
UserController --> UserResourceAssembler : uses >
UserResourceAssembler --> UserProfileResource : creates >

@enduml