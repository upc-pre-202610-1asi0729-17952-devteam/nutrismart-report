DailyIntakeCommandServiceImpl ..|> DailyIntakeCommandService
FoodItemCommandServiceImpl ..|> FoodItemCommandService
MealRecordCommandServiceImpl ..|> MealRecordCommandService
FoodImportCommandServiceImpl ..|> FoodImportCommandService
SmartScanCommandServiceImpl ..|> SmartScanCommandService
DailyIntakeQueryServiceImpl ..|> DailyIntakeQueryService
FoodItemQueryServiceImpl ..|> FoodItemQueryService
MealRecordQueryServiceImpl ..|> MealRecordQueryService

DailyIntakeCommandServiceImpl --> DailyIntakeRepository : uses >
FoodItemCommandServiceImpl --> FoodItemRepository : uses >
MealRecordCommandServiceImpl --> MealRecordRepository : uses >
DailyIntakeQueryServiceImpl --> DailyIntakeRepository : uses >
FoodItemQueryServiceImpl --> FoodItemRepository : uses >
MealRecordQueryServiceImpl --> MealRecordRepository : uses >

FoodImportCommandServiceImpl --> ExternalFoodDataPort : uses >
FoodImportCommandServiceImpl --> FoodEnrichmentPort : uses >
FoodImportCommandServiceImpl --> FoodItemRepository : uses >
FoodImportCommandServiceImpl --> FoodItemImportWriter : uses >
FoodItemImportWriter --> FoodItemRepository : uses >

SmartScanCommandServiceImpl --> PlateImageRecognitionPort : uses >
SmartScanCommandServiceImpl --> PlateItemMatchPort : uses >
SmartScanCommandServiceImpl --> FoodItemRepository : uses >
SmartScanCommandServiceImpl --> MealRecordCommandService : uses >

DailyIntakeCommandServiceImpl ..> CreateDailyIntakeCommand : handles >
DailyIntakeCommandServiceImpl ..> UpdateDailyIntakeCommand : handles >
DailyIntakeCommandServiceImpl ..> DailyIntake : produces >
FoodItemCommandServiceImpl ..> RegisterFoodItemCommand : handles >
FoodItemCommandServiceImpl ..> UpdateFoodItemCommand : handles >
FoodItemCommandServiceImpl ..> DeleteFoodItemCommand : handles >
FoodItemCommandServiceImpl ..> FoodItem : produces >
FoodImportCommandServiceImpl ..> ImportFoodItemsCommand : handles >
MealRecordCommandServiceImpl ..> LogMealCommand : handles >
MealRecordCommandServiceImpl ..> UpdateMealEntryCommand : handles >
MealRecordCommandServiceImpl ..> DeleteMealLogCommand : handles >
MealRecordCommandServiceImpl ..> MealRecord : produces >
SmartScanCommandServiceImpl ..> ScanPlateCommand : handles >
SmartScanCommandServiceImpl ..> ConfirmPlateScanCommand : handles >

NutritionTrackingContextFacadeImpl --> DailyIntakeQueryService : uses >
NutritionTrackingContextFacadeImpl --> MealRecordQueryService : uses >

' ─── Relationships (legacy menu-scan use case — superseded, no active service) ─
' These types once formed the in-context menu-scan flow before it was
' extracted into the restaurantintelligence BC. Wired here to show the
' original use-case shape; no @Service handles them anymore.
ScanMenuCommand ..> ImageRecognitionPort : (legacy) dishes detected via >
ScanMenuCommand ..> MenuRankingPort : (legacy) ranked via >
ScanMenuCommand ..> UserProfileLookupPort : (legacy) profiled via >

@enduml
