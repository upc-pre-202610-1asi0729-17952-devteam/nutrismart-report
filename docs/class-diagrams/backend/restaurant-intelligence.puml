@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "restaurant.domain.model.aggregates" {
  class MenuAnalysis {
    - id: MenuAnalysisId
    - userId: UUID
    - rawImageText: String
    - dishes: List<AnalyzedDish>
    - rankedDishes: List<AnalyzedDish>
    - bestDish: AnalyzedDish
    - analyzedAt: Instant
    + MenuAnalysis(userId: UUID, rawImageText: String)
    + addDish(dish: AnalyzedDish): void
    + rankDishes(goal: String): void
    + filterByRestrictions(restrictions: List<String>): void
    + getBestDish(): AnalyzedDish
    + getId(): MenuAnalysisId
  }
}

package "restaurant.domain.model.entities" {
  class AnalyzedDish {
    - id: AnalyzedDishId
    - name: String
    - estimatedMacros: MacroNutrients
    - isRestricted: boolean
    - restrictionReason: String
    - compatibilityScore: double
    - rankPosition: int
    + AnalyzedDish(name: String, estimatedMacros: MacroNutrients)
    + flagAsRestricted(reason: String): void
    + setRank(position: int, score: double): void
    + isCompatible(): boolean
    + getId(): AnalyzedDishId
  }
}

package "restaurant.domain.model.valueobjects" {
  class MenuAnalysisId <<ValueObject>> {
    - value: UUID
    + getValue(): UUID
  }
  class AnalyzedDishId <<ValueObject>> {
    - value: UUID
    + getValue(): UUID
  }
  class MacroNutrients <<ValueObject>> {
    - calories: double
    - proteinG: double
    - carbsG: double
    - fatG: double
    + MacroNutrients(calories: double, proteinG: double, carbsG: double, fatG: double)
    + add(other: MacroNutrients): MacroNutrients
    + scale(factor: double): MacroNutrients
  }
}

package "restaurant.domain.model.enums" {
  enum RankingCriteria {
    LOWEST_CALORIE_DENSITY
    HIGHEST_PROTEIN
    + forGoal(goal: String): RankingCriteria
  }
}

package "restaurant.domain.model.events" {
  class MenuPhotoProcessed <<DomainEvent>> {
    + userId: UUID
    + analysisId: UUID
    + dishesDetected: int
    + occurredOn: Instant
  }
  class RestaurantMealAnalyzed <<DomainEvent>> {
    + userId: UUID
    + analysisId: UUID
    + occurredOn: Instant
  }
  class RestrictedDishFlagged <<DomainEvent>> {
    + userId: UUID
    + dishName: String
    + restrictionReason: String
    + occurredOn: Instant
  }
  class CompatibleDishesRanked <<DomainEvent>> {
    + userId: UUID
    + analysisId: UUID
    + bestDishName: String
    + occurredOn: Instant
  }
}

package "restaurant.domain.repositories" {
  interface MenuAnalysisRepository {
    + findByUserId(userId: UUID): List<MenuAnalysis>
    + findById(id: MenuAnalysisId): Optional<MenuAnalysis>
    + findLatestByUserId(userId: UUID): Optional<MenuAnalysis>
    + save(analysis: MenuAnalysis): MenuAnalysis
  }
}

package "restaurant.application.internal.commandservices" {
  class RestaurantCommandService {
    - analysisRepository: MenuAnalysisRepository
    - visionAdapter: GoogleCloudVisionAdapter
    - openFoodFactsAdapter: OpenFoodFactsAdapter
    - usdaAdapter: UsdaFoodDataAdapter
    + handle(command: ScanMenuPhotoCommand): MenuAnalysis
    + handle(command: AnalyzeMenuItemsCommand): MenuAnalysis
    + handle(command: FilterByRestrictionsCommand): MenuAnalysis
    + handle(command: RankCompatibleDishesCommand): MenuAnalysis
  }
  class ScanMenuPhotoCommand <<Command>> {
    + userId: UUID
    + imageBase64: String
    + goal: String
    + dietaryRestrictions: List<String>
  }
  class AnalyzeMenuItemsCommand <<Command>> {
    + analysisId: UUID
  }
  class FilterByRestrictionsCommand <<Command>> {
    + analysisId: UUID
    + restrictions: List<String>
  }
  class RankCompatibleDishesCommand <<Command>> {
    + analysisId: UUID
    + goal: String
  }
}

package "restaurant.application.internal.queryservices" {
  class RestaurantQueryService {
    - analysisRepository: MenuAnalysisRepository
    + handle(query: GetMenuAnalysisQuery): Optional<MenuAnalysis>
    + handle(query: GetLatestMenuAnalysisQuery): Optional<MenuAnalysis>
  }
  class GetMenuAnalysisQuery <<Query>> {
    + analysisId: UUID
  }
  class GetLatestMenuAnalysisQuery <<Query>> {
    + userId: UUID
  }
}

package "restaurant.infrastructure.external" {
  class GoogleCloudVisionAdapter {
    - httpClient: WebClient
    - apiKey: String
    + extractTextFromImage(imageBase64: String): String
    + isValidFoodImage(imageBase64: String): boolean
  }
  class OpenFoodFactsAdapter {
    - httpClient: WebClient
    + estimateMacrosByName(dishName: String): Optional<MacroNutrients>
  }
  class UsdaFoodDataAdapter {
    - httpClient: WebClient
    - apiKey: String
    + estimateMacrosByName(dishName: String): Optional<MacroNutrients>
  }
}

package "restaurant.interfaces.rest.resources" {
  class ScanMenuResource {
    + imageBase64: String
    + goal: String
    + dietaryRestrictions: List<String>
  }
  class AnalyzedDishResource {
    + id: UUID
    + name: String
    + calories: double
    + proteinG: double
    + carbsG: double
    + fatG: double
    + isRestricted: boolean
    + restrictionReason: String
    + compatibilityScore: double
    + rankPosition: int
  }
  class MenuAnalysisResource {
    + id: UUID
    + analyzedAt: String
    + bestDish: AnalyzedDishResource
    + rankedDishes: List<AnalyzedDishResource>
    + totalDishesDetected: int
    + compatibleCount: int
  }
}

package "restaurant.interfaces.rest.assemblers" {
  class MenuAnalysisAssembler {
    + toResourceFromEntity(analysis: MenuAnalysis): MenuAnalysisResource
    + toDishResource(dish: AnalyzedDish): AnalyzedDishResource
  }
}

package "restaurant.interfaces.rest.controllers" {
  class RestaurantController {
    - commandService: RestaurantCommandService
    - queryService: RestaurantQueryService
    + scanMenu(userId: UUID, resource: ScanMenuResource): ResponseEntity<MenuAnalysisResource>
    + getLatestAnalysis(userId: UUID): ResponseEntity<MenuAnalysisResource>
    + getAnalysis(analysisId: UUID): ResponseEntity<MenuAnalysisResource>
  }
}

MenuAnalysis "1" *--> "0..*" AnalyzedDish : contains >
MenuAnalysis "1" *--> "1" MenuAnalysisId : identified by >
AnalyzedDish "1" *--> "1" MacroNutrients : has >
MenuAnalysis ..> MenuPhotoProcessed : publishes >
MenuAnalysis ..> RestaurantMealAnalyzed : publishes >
MenuAnalysis ..> RestrictedDishFlagged : publishes >
MenuAnalysis ..> CompatibleDishesRanked : publishes >

RestaurantCommandService --> MenuAnalysisRepository : uses >
RestaurantCommandService --> GoogleCloudVisionAdapter : uses >
RestaurantCommandService --> OpenFoodFactsAdapter : uses >
RestaurantCommandService --> UsdaFoodDataAdapter : uses >
RestaurantQueryService --> MenuAnalysisRepository : uses >

RestaurantController --> RestaurantCommandService : uses >
RestaurantController --> RestaurantQueryService : uses >
RestaurantController --> MenuAnalysisAssembler : uses >
MenuAnalysisAssembler --> MenuAnalysisResource : creates >

@enduml