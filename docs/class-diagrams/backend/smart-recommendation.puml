@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "recommendations.domain.model.aggregates" {
  class RecommendationSet {
    - id: RecommendationSetId
    - userId: UUID
    - context: RecommendationContext
    - type: RecommendationType
    - items: List<Recommendation>
    - generatedAt: Instant
    - expiresAt: Instant
    + RecommendationSet(userId: UUID, context: RecommendationContext, type: RecommendationType)
    + addRecommendation(rec: Recommendation): void
    + isExpired(): boolean
    + getItems(): List<Recommendation>
    + getId(): RecommendationSetId
  }
  class PantrySnapshot {
    - id: PantrySnapshotId
    - userId: UUID
    - items: List<PantryItem>
    - updatedAt: Instant
    + PantrySnapshot(userId: UUID)
    + addItem(item: PantryItem): void
    + removeItem(itemId: PantryItemId): void
    + getId(): PantrySnapshotId
  }
}

package "recommendations.domain.model.entities" {
  class Recommendation {
    - id: RecommendationId
    - type: RecommendationType
    - title: String
    - description: String
    - priority: int
    - foodItemRef: UUID
    + Recommendation(type: RecommendationType, title: String, description: String)
    + getPriority(): int
  }
  class PantryItem {
    - id: PantryItemId
    - name: String
    - quantity: double
    - unit: String
    + PantryItem(name: String, quantity: double, unit: String)
    + getId(): PantryItemId
  }
}

package "recommendations.domain.model.valueobjects" {
  class RecommendationSetId <<ValueObject>> {
    - value: UUID
    + getValue(): UUID
  }
  class RecommendationId <<ValueObject>> {
    - value: UUID
    + getValue(): UUID
  }
  class PantrySnapshotId <<ValueObject>> {
    - value: UUID
    + getValue(): UUID
  }
  class PantryItemId <<ValueObject>> {
    - value: UUID
    + getValue(): UUID
  }
  class RecommendationContext <<ValueObject>> {
    - caloriesConsumed: double
    - calorieTarget: double
    - weatherCondition: String
    - temperatureCelsius: double
    - currentHour: int
    - goal: String
    - city: String
    - dietaryRestrictions: List<String>
    + RecommendationContext(caloriesConsumed: double, calorieTarget: double, goal: String)
    + getCalorieDeficit(): double
    + isMealTime(): boolean
    + isHotWeather(): boolean
    + isColdWeather(): boolean
  }
}

package "recommendations.domain.model.enums" {
  enum RecommendationType {
    PREVENTIVE
    INTERVENTION
    STRATEGY_ADJUSTMENT
    GRADUAL_ADJUSTMENT
    BEST_DISH
    WEATHER_BASED
    TRAVEL_LOCAL
    PANTRY_RECIPE
  }
  enum PremiumFeatureStatus {
    LOCKED
    UNLOCKED
  }
}

package "recommendations.domain.model.events" {
  class PreventiveRecommendationGenerated <<DomainEvent>> {
    + userId: UUID
    + setId: UUID
    + occurredOn: Instant
  }
  class InterventionRecommendationGenerated <<DomainEvent>> {
    + userId: UUID
    + setId: UUID
    + occurredOn: Instant
  }
  class StrategyAdjustmentSuggested <<DomainEvent>> {
    + userId: UUID
    + setId: UUID
    + occurredOn: Instant
  }
  class GradualAdjustmentSuggested <<DomainEvent>> {
    + userId: UUID
    + setId: UUID
    + occurredOn: Instant
  }
  class BestDishRecommended <<DomainEvent>> {
    + userId: UUID
    + dishName: String
    + occurredOn: Instant
  }
  class WeatherAdaptedMealSuggested <<DomainEvent>> {
    + userId: UUID
    + setId: UUID
    + occurredOn: Instant
  }
  class LocalDishesRecommended <<DomainEvent>> {
    + userId: UUID
    + city: String
    + occurredOn: Instant
  }
  class RecipeSuggested <<DomainEvent>> {
    + userId: UUID
    + setId: UUID
    + occurredOn: Instant
  }
  class PremiumFeaturesUnlocked <<DomainEvent>> {
    + userId: UUID
    + occurredOn: Instant
  }
  class PremiumFeaturesLocked <<DomainEvent>> {
    + userId: UUID
    + occurredOn: Instant
  }
}

package "recommendations.domain.repositories" {
  interface RecommendationSetRepository {
    + findLatestByUserId(userId: UUID): Optional<RecommendationSet>
    + findByUserIdAndType(userId: UUID, type: RecommendationType): List<RecommendationSet>
    + save(set: RecommendationSet): RecommendationSet
  }
  interface PantrySnapshotRepository {
    + findByUserId(userId: UUID): Optional<PantrySnapshot>
    + save(snapshot: PantrySnapshot): PantrySnapshot
  }
}

package "recommendations.application.internal.commandservices" {
  class RecommendationCommandService {
    - recommendationRepository: RecommendationSetRepository
    - pantryRepository: PantrySnapshotRepository
    - weatherAdapter: WeatherContextAdapter
    + handle(command: GeneratePreventiveRecommendationCommand): RecommendationSet
    + handle(command: RequestInterventionRecommendationCommand): RecommendationSet
    + handle(command: SuggestStrategyAdjustmentCommand): RecommendationSet
    + handle(command: SuggestGradualAdjustmentCommand): RecommendationSet
    + handle(command: SuggestBestDishCommand): RecommendationSet
    + handle(command: GenerateWeatherRecommendationCommand): RecommendationSet
    + handle(command: GenerateTravelRecommendationCommand): RecommendationSet
    + handle(command: RegisterPantryItemsCommand): PantrySnapshot
    + handle(command: UnlockPremiumFeaturesCommand): void
    + handle(command: LockPremiumFeaturesCommand): void
  }
  class GeneratePreventiveRecommendationCommand <<Command>> {
    + userId: UUID
    + caloriesConsumed: double
    + calorieTarget: double
    + goal: String
  }
  class RequestInterventionRecommendationCommand <<Command>> {
    + userId: UUID
    + caloriesConsumed: double
    + calorieTarget: double
    + goal: String
  }
  class SuggestStrategyAdjustmentCommand <<Command>> {
    + userId: UUID
    + currentCalorieTarget: double
    + goal: String
  }
  class SuggestGradualAdjustmentCommand <<Command>> {
    + userId: UUID
    + currentCalorieTarget: double
    + adherenceHistory: List<String>
  }
  class SuggestBestDishCommand <<Command>> {
    + userId: UUID
    + bestDishName: String
    + bestDishCalories: double
    + bestDishProteinG: double
    + caloriesConsumed: double
    + calorieTarget: double
  }
  class GenerateWeatherRecommendationCommand <<Command>> {
    + userId: UUID
    + latitude: double
    + longitude: double
    + caloriesConsumed: double
    + calorieTarget: double
    + goal: String
    + dietaryRestrictions: List<String>
  }
  class GenerateTravelRecommendationCommand <<Command>> {
    + userId: UUID
    + city: String
    + dietaryRestrictions: List<String>
  }
  class RegisterPantryItemsCommand <<Command>> {
    + userId: UUID
    + items: List<PantryItemDto>
  }
  class UnlockPremiumFeaturesCommand <<Command>> {
    + userId: UUID
  }
  class LockPremiumFeaturesCommand <<Command>> {
    + userId: UUID
  }
}

package "recommendations.application.internal.queryservices" {
  class RecommendationQueryService {
    - recommendationRepository: RecommendationSetRepository
    - pantryRepository: PantrySnapshotRepository
    + handle(query: GetLatestRecommendationsQuery): Optional<RecommendationSet>
    + handle(query: GetRecommendationsByTypeQuery): List<RecommendationSet>
    + handle(query: GetPantryQuery): Optional<PantrySnapshot>
  }
  class GetLatestRecommendationsQuery <<Query>> {
    + userId: UUID
  }
  class GetRecommendationsByTypeQuery <<Query>> {
    + userId: UUID
    + type: String
  }
  class GetPantryQuery <<Query>> {
    + userId: UUID
  }
}

package "recommendations.infrastructure.external" {
  class WeatherContextAdapter {
    - httpClient: WebClient
    - apiKey: String
    + getWeatherContext(lat: double, lon: double): WeatherData
  }
  class WeatherData {
    + condition: String
    + temperatureCelsius: double
    + humidity: int
  }
}

package "recommendations.interfaces.rest.resources" {
  class RecommendationResource {
    + id: UUID
    + type: String
    + title: String
    + description: String
    + priority: int
  }
  class RecommendationSetResource {
    + id: UUID
    + type: String
    + generatedAt: String
    + expiresAt: String
    + items: List<RecommendationResource>
  }
  class GenerateWeatherRecommendationResource {
    + latitude: double
    + longitude: double
    + caloriesConsumed: double
    + calorieTarget: double
    + goal: String
    + dietaryRestrictions: List<String>
  }
  class PantryItemResource {
    + id: UUID
    + name: String
    + quantity: double
    + unit: String
  }
  class PantrySnapshotResource {
    + userId: UUID
    + items: List<PantryItemResource>
    + updatedAt: String
  }
}

package "recommendations.interfaces.rest.assemblers" {
  class RecommendationAssembler {
    + toResourceFromEntity(set: RecommendationSet): RecommendationSetResource
    + toItemResource(rec: Recommendation): RecommendationResource
  }
  class PantryAssembler {
    + toResourceFromEntity(snapshot: PantrySnapshot): PantrySnapshotResource
    + toItemResource(item: PantryItem): PantryItemResource
  }
}

package "recommendations.interfaces.rest.controllers" {
  class RecommendationController {
    - commandService: RecommendationCommandService
    - queryService: RecommendationQueryService
    + getLatest(userId: UUID): ResponseEntity<RecommendationSetResource>
    + getByType(userId: UUID, type: String): ResponseEntity<List<RecommendationSetResource>>
    + generateWeatherBased(userId: UUID, resource: GenerateWeatherRecommendationResource): ResponseEntity<RecommendationSetResource>
    + generateTravelMode(userId: UUID, city: String): ResponseEntity<RecommendationSetResource>
  }
  class PantryController {
    - commandService: RecommendationCommandService
    - queryService: RecommendationQueryService
    + getPantry(userId: UUID): ResponseEntity<PantrySnapshotResource>
    + registerItems(userId: UUID, items: List<PantryItemResource>): ResponseEntity<PantrySnapshotResource>
  }
}

RecommendationSet "1" *--> "1..*" Recommendation : contains >
RecommendationSet "1" *--> "1" RecommendationContext : based on >
RecommendationSet "1" *--> "1" RecommendationType : typed as >
PantrySnapshot "1" *--> "0..*" PantryItem : stores >
Recommendation "1" *--> "1" RecommendationType : has >

RecommendationSet ..> PreventiveRecommendationGenerated : publishes >
RecommendationSet ..> InterventionRecommendationGenerated : publishes >
RecommendationSet ..> StrategyAdjustmentSuggested : publishes >
RecommendationSet ..> GradualAdjustmentSuggested : publishes >
RecommendationSet ..> BestDishRecommended : publishes >
RecommendationSet ..> WeatherAdaptedMealSuggested : publishes >
RecommendationSet ..> LocalDishesRecommended : publishes >
RecommendationSet ..> RecipeSuggested : publishes >

RecommendationCommandService --> RecommendationSetRepository : uses >
RecommendationCommandService --> PantrySnapshotRepository : uses >
RecommendationCommandService --> WeatherContextAdapter : uses >
RecommendationQueryService --> RecommendationSetRepository : uses >
RecommendationQueryService --> PantrySnapshotRepository : uses >

RecommendationController --> RecommendationCommandService : uses >
RecommendationController --> RecommendationQueryService : uses >
RecommendationController --> RecommendationAssembler : uses >
PantryController --> RecommendationCommandService : uses >
PantryController --> RecommendationQueryService : uses >
PantryController --> PantryAssembler : uses >

@enduml