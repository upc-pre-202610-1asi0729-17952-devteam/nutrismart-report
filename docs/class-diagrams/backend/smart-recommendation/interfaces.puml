RecommendationSessionsController ..> CreateRecommendationSessionCommandFromResourceAssembler : uses >
RecommendationSessionsController ..> RecommendationSessionResourceFromEntityAssembler : uses >
RecommendationSessionsController ..> UpdateRecommendationSessionResource : consumes >
TravelContextsController ..> CreateTravelContextResource : consumes >
TravelContextsController ..> TravelContextResource : produces >
TravelContextsController ..> CreateTravelContextCommandFromResourceAssembler : uses >
TravelContextsController ..> TravelContextResourceFromEntityAssembler : uses >
TravelContextsController ..> UpdateTravelContextResource : consumes >
UserLocationSnapshotsController ..> CreateLocationSnapshotResource : consumes >
