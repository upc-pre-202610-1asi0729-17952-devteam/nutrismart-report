@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

title Smart Recommendation — Interfaces layer (nutrismart-platform)

' ─── Boundary stubs: application layer ───────────────────────────────────────
package "smartrecommendation.application [boundary]" {
  interface PantryItemCommandService <<port>>
  interface PantryItemQueryService <<port>>
  interface RecipeSuggestionCommandService <<port>>
  interface RecipeSuggestionQueryService <<port>>
  interface RecommendationCardCommandService <<port>>
  interface RecommendationCardQueryService <<port>>
  interface RecommendationSessionCommandService <<port>>
  interface RecommendationSessionQueryService <<port>>
  interface TravelContextCommandService <<port>>
  interface TravelContextQueryService <<port>>
  interface LocationSnapshotCommandService <<port>>
  interface LocationSnapshotQueryService <<port>>
  interface WeatherSnapshotCommandService <<port>>
  interface WeatherSnapshotQueryService <<port>>
}

package "smartrecommendation.interfaces.rest" {
  class PantryController <<@RestController>>
  class RecipesController <<@RestController>>
  class RecommendationCardsController <<@RestController>> {
    - generationLock: RecommendationCardGenerationLock
  }
  class RecommendationSessionsController <<@RestController>>
  class TravelContextsController <<@RestController>>
  class UserLocationSnapshotsController <<@RestController>>
  class WeatherSnapshotsController <<@RestController>>
}

package "smartrecommendation.interfaces.rest.resources" {
  class CreatePantryItemResource <<resource>>
  class PantryItemResource <<resource>>
  class CreateRecipeSuggestionResource <<resource>>
  class RecipeSuggestionResource <<resource>>
  class CreateRecommendationCardResource <<resource>>
  class RecommendationCardResource <<resource>>
  class CreateRecommendationSessionResource <<resource>>
  class UpdateRecommendationSessionResource <<resource>>
  class RecommendationSessionResource <<resource>>
  class CreateTravelContextResource <<resource>>
  class UpdateTravelContextResource <<resource>>
  class TravelContextResource <<resource>>
  class CreateLocationSnapshotResource <<resource>>
  class LocationSnapshotResource <<resource>>
  class CreateWeatherSnapshotResource <<resource>>
  class UpdateWeatherSnapshotResource <<resource>>
  class SyncWeatherSnapshotResource <<resource>>
  class WeatherSnapshotResource <<resource>>
}

package "smartrecommendation.interfaces.rest.transform" {
  class AddPantryItemCommandFromResourceAssembler <<assembler>>
  class PantryItemResourceFromEntityAssembler <<assembler>>
  class CreateRecipeSuggestionCommandFromResourceAssembler <<assembler>>
  class RecipeSuggestionResourceFromEntityAssembler <<assembler>>
  class CreateRecommendationCardCommandFromResourceAssembler <<assembler>>
  class RecommendationCardResourceFromEntityAssembler <<assembler>>
  class CreateRecommendationSessionCommandFromResourceAssembler <<assembler>>
  class RecommendationSessionResourceFromEntityAssembler <<assembler>>
  class CreateTravelContextCommandFromResourceAssembler <<assembler>>
  class TravelContextResourceFromEntityAssembler <<assembler>>
  class CreateLocationSnapshotCommandFromResourceAssembler <<assembler>>
  class LocationSnapshotResourceFromEntityAssembler <<assembler>>
  class CreateWeatherSnapshotCommandFromResourceAssembler <<assembler>>
  class SyncWeatherSnapshotCommandFromResourceAssembler <<assembler>>
  class WeatherSnapshotResourceFromEntityAssembler <<assembler>>
}

' ─── Relationships: controllers use services ─────────────────────────────────
PantryController --> PantryItemCommandService : uses >
PantryController --> PantryItemQueryService : uses >
RecipesController --> RecipeSuggestionCommandService : uses >
RecipesController --> RecipeSuggestionQueryService : uses >
RecommendationCardsController --> RecommendationCardCommandService : uses >
RecommendationCardsController --> RecommendationCardQueryService : uses >
RecommendationSessionsController --> RecommendationSessionCommandService : uses >
RecommendationSessionsController --> RecommendationSessionQueryService : uses >
TravelContextsController --> TravelContextCommandService : uses >
TravelContextsController --> TravelContextQueryService : uses >
UserLocationSnapshotsController --> LocationSnapshotCommandService : uses >
UserLocationSnapshotsController --> LocationSnapshotQueryService : uses >
WeatherSnapshotsController --> WeatherSnapshotCommandService : uses >
WeatherSnapshotsController --> WeatherSnapshotQueryService : uses >

