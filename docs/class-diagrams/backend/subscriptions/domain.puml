@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

title Subscriptions — Domain layer (nutrismart-platform)

package "subscriptions.domain.model.aggregates" {
  class Subscription <<aggregate root>> {
    - id: Long
    - userId: Long
    - plan: SubscriptionPlan
    - status: SubscriptionStatus
    - billingCycleStart: LocalDate
    - billingCycleEnd: LocalDate
    - createdAt: Instant
    --
    + {static} create(userId: Long, plan: SubscriptionPlan): Subscription
    + {static} rehydrate(...): Subscription
    + update(plan, status, ...): void
  }
  class BillingRecord <<aggregate root>> {
    - id: Long
    - userId: Long
    - plan: SubscriptionPlan
    - amount: Double
    - currency: String
    - paidAt: Instant
    - status: String
    --
    + {static} create(userId, plan, amount, ...): BillingRecord
    + {static} rehydrate(...): BillingRecord
  }
  class PaymentMethod <<aggregate root>> {
    - id: Long
    - userId: Long
    - lastFour: String
    - brand: String
    - expiryMonth: Integer
    - expiryYear: Integer
    - cardholderName: String
    - stripePaymentMethodId: String
    - stripeCustomerId: String
    - createdAt: Instant
    --
    + {static} create(userId, lastFour, brand, ...): PaymentMethod
    + {static} rehydrate(...): PaymentMethod
    + applyStripeCustomer(stripeCustomerId: String): void
  }
}

package "subscriptions.domain.model.valueobjects" {
  enum SubscriptionPlan {
    BASIC
    PRO
    PREMIUM
  }
  enum SubscriptionStatus {
    ACTIVE
    CANCELLED
    EXPIRED
  }
}

package "subscriptions.domain.model.repositories" {
  interface SubscriptionRepository <<port>> {
    + findById(id: Long): Optional<Subscription>
    + findByUserId(userId: Long): Optional<Subscription>
    + findAll(): List<Subscription>
    + save(s: Subscription): Subscription
  }
  interface BillingRecordRepository <<port>> {
    + findById(id: Long): Optional<BillingRecord>
    + findAll(): List<BillingRecord>
    + save(r: BillingRecord): BillingRecord
  }
  interface PaymentMethodRepository <<port>> {
    + findById(id: Long): Optional<PaymentMethod>
    + findByUserId(userId: Long): List<PaymentMethod>
    + findAnyStripeCustomerIdByUserId(userId: Long): Optional<String>
    + save(pm: PaymentMethod): PaymentMethod
    + existsById(id: Long): boolean
    + deleteById(id: Long): void
  }
}

package "subscriptions.domain.model.services" {
  interface PaymentGateway <<domain service / port>> {
    + ensureCustomer(userId, existingCustomerId, stripePaymentMethodId): String
    + charge(stripeCustomerId, stripePaymentMethodId, amount, currency): PaymentResult
  }
  class PaymentResult <<record>> {
    + success: boolean
    + transactionId: String
    + failureReason: String
    + {static} ok(transactionId): PaymentResult
    + {static} failed(reason): PaymentResult
  }
}

package "subscriptions.domain.model.exceptions" {
  class DomainInvalidExceptions <<exception>>
}

' ─── Relationships ────────────────────────────────────────────────────────────
Subscription "1" o--> "1" SubscriptionPlan : plan >
Subscription "1" o--> "1" SubscriptionStatus : status >
BillingRecord "1" o--> "1" SubscriptionPlan : billed for >
BillingRecord "0..*" ..> "1" Subscription : settles >

SubscriptionRepository ..> Subscription : persists >
BillingRecordRepository ..> BillingRecord : persists >
PaymentMethodRepository ..> PaymentMethod : persists >
PaymentGateway ..> PaymentResult : returns >
PaymentGateway ..> PaymentMethod : charges via stripeId of >
DomainInvalidExceptions ..> Subscription : guards invariants of >

@enduml
