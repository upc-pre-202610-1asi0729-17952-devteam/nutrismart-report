@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

title Subscriptions — Interfaces layer (nutrismart-platform)

' ─── Boundary stubs: application layer ───────────────────────────────────────
package "subscriptions.application [boundary]" {
  interface SubscriptionCommandService <<port>>
  interface SubscriptionQueryService <<port>>
  interface BillingRecordCommandService <<port>>
  interface BillingRecordQueryService <<port>>
  interface PaymentMethodCommandService <<port>>
  interface PaymentMethodQueryService <<port>>
  interface PaymentCommandService <<port>>
}

package "subscriptions.interfaces.rest" {
  class SubscriptionsController <<@RestController>> {
    - commandService: SubscriptionCommandService
    - queryService: SubscriptionQueryService
  }
  class BillingHistoryController <<@RestController>> {
    - commandService: BillingRecordCommandService
    - queryService: BillingRecordQueryService
  }
  class PaymentMethodsController <<@RestController>> {
    - commandService: PaymentMethodCommandService
    - queryService: PaymentMethodQueryService
  }
  class PaymentsController <<@RestController>> {
    - commandService: PaymentCommandService
  }
}

package "subscriptions.interfaces.rest.resources" {
  class CreateSubscriptionResource <<resource>>
  class UpdateSubscriptionResource <<resource>>
  class SubscriptionResource <<resource>>
  class CreateBillingRecordResource <<resource>>
  class BillingRecordResource <<resource>>
  class RegisterPaymentMethodResource <<resource>>
  class PaymentMethodResource <<resource>>
  class ProcessPaymentResource <<resource>>
  class PaymentResultResource <<resource>>
}

package "subscriptions.interfaces.rest.transform" {
  class SubscriptionCommandFromResourceAssembler <<assembler>>
  class SubscriptionResourceFromEntityAssembler <<assembler>>
  class BillingRecordCommandFromResourceAssembler <<assembler>>
  class BillingRecordResourceFromEntityAssembler <<assembler>>
  class PaymentMethodCommandFromResourceAssembler <<assembler>>
  class PaymentMethodResourceFromEntityAssembler <<assembler>>
}

' ─── Relationships ────────────────────────────────────────────────────────────
SubscriptionsController --> SubscriptionCommandService : uses >
SubscriptionsController --> SubscriptionQueryService : uses >
BillingHistoryController --> BillingRecordCommandService : uses >
BillingHistoryController --> BillingRecordQueryService : uses >

SubscriptionsController ..> CreateSubscriptionResource : consumes >
SubscriptionsController ..> SubscriptionResource : produces >
SubscriptionsController ..> SubscriptionCommandFromResourceAssembler : uses >
SubscriptionsController ..> SubscriptionResourceFromEntityAssembler : uses >
SubscriptionsController ..> UpdateSubscriptionResource : consumes >
BillingHistoryController ..> CreateBillingRecordResource : consumes >
BillingHistoryController ..> BillingRecordResource : produces >
BillingHistoryController ..> BillingRecordCommandFromResourceAssembler : uses >
BillingHistoryController ..> BillingRecordResourceFromEntityAssembler : uses >

SubscriptionCommandFromResourceAssembler ..> CreateSubscriptionResource : reads >
SubscriptionResourceFromEntityAssembler ..> SubscriptionResource : builds >
BillingRecordCommandFromResourceAssembler ..> CreateBillingRecordResource : reads >
BillingRecordResourceFromEntityAssembler ..> BillingRecordResource : builds >

' ─── Payment methods & payments ──────────────────────────────────────────────
PaymentMethodsController --> PaymentMethodCommandService : uses >
PaymentMethodsController --> PaymentMethodQueryService : uses >
PaymentsController --> PaymentCommandService : uses >

PaymentMethodsController ..> RegisterPaymentMethodResource : consumes >
PaymentMethodsController ..> PaymentMethodResource : produces >
PaymentMethodsController ..> PaymentMethodCommandFromResourceAssembler : uses >
PaymentMethodsController ..> PaymentMethodResourceFromEntityAssembler : uses >
PaymentsController ..> ProcessPaymentResource : consumes >
PaymentsController ..> PaymentResultResource : produces >

PaymentMethodCommandFromResourceAssembler ..> RegisterPaymentMethodResource : reads >
PaymentMethodResourceFromEntityAssembler ..> PaymentMethodResource : builds >

@enduml
