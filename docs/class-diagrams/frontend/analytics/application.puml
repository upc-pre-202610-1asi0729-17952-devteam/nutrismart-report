@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

title Analytics — Application layer (nutrismart-webapp)

' ─── Boundary stubs: domain & infrastructure ─────────────────────────────────
package "analytics/domain [boundary]" {
  class AnalyticsData <<interface>>
}
package "analytics/infrastructure [boundary]" {
  class AnalyticsApi <<api>>
  class AnalyticsAssembler <<assembler>>
  class PdfGeneratorService <<service>>
}
package "iam/application [boundary]" {
  class IamStore <<store>>
}

package "analytics/application" {
  class AnalyticsStore <<@Injectable store>> {
    - analyticsApi: AnalyticsApi
    - analyticsAssembler: AnalyticsAssembler
    - pdfGenerator: PdfGeneratorService
    - iamStore: IamStore
    --
    + currentAnalyticsData: Signal<AnalyticsData | null>
    + loading: Signal<boolean>
    + error: Signal<string | null>
    + selectedPeriod: Signal<AnalyticsPeriod>
    + isPremiumUser: Signal<boolean>
    + allowedPeriods: Signal<AnalyticsPeriod[]>
    + exportPdfModalOpen: Signal<boolean>
    --
    + loadAnalyticsData(period: AnalyticsPeriod): Observable<AnalyticsData | undefined>
    + exportReport(options: PdfReportOptions): Observable<Blob>
    + openExportPdfModal(): void
    + closeExportPdfModal(): void
  }
}

' ─── Relationships ────────────────────────────────────────────────────────────
AnalyticsStore --> AnalyticsApi : uses >
AnalyticsStore --> AnalyticsAssembler : maps via >
AnalyticsStore --> PdfGeneratorService : exports via >
AnalyticsStore --> IamStore : reads user/plan >
AnalyticsStore ..> AnalyticsData : holds >

@enduml
