@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

title Analytics — Infrastructure layer (nutrismart-webapp)

' ─── Boundary stubs: domain layer ────────────────────────────────────────────
package "analytics/domain [boundary]" {
  class AnalyticsData <<interface>>
}

package "analytics/infrastructure" {
  abstract class AnalyticsApi <<abstract>> {
    + {abstract} getHistory(userId, fromDate): Observable<AnalyticsRawInput>
    + {abstract} exportPdfReport(userId, fromDate, toDate): Observable<Blob>
  }
  class AnalyticsApiHttpService <<@Injectable>> {
    + getHistory(userId, fromDate): Observable<AnalyticsRawInput>
  }
  class AnalyticsAssembler <<@Injectable>> {
    + toAnalyticsData(raw: AnalyticsRawInput): AnalyticsData
  }
  class PdfGeneratorService <<@Injectable>> {
    + generate(data: AnalyticsData, options: PdfReportOptions, userName?): Blob
  }
  interface AnalyticsRawInput <<resource>>
  interface NutritionLogResource <<resource>>
  interface BodyMetricResource <<resource>>
  interface UserTargets <<resource>>
  interface PdfReportOptions <<options>>
}

' ─── Relationships ────────────────────────────────────────────────────────────
AnalyticsApiHttpService --|> AnalyticsApi
AnalyticsApiHttpService ..> AnalyticsRawInput : returns >
AnalyticsRawInput "1" *--> "0..*" NutritionLogResource : aggregates >
AnalyticsRawInput "1" *--> "0..*" BodyMetricResource : aggregates >
AnalyticsRawInput "1" *--> "1" UserTargets : includes >
AnalyticsAssembler ..> AnalyticsRawInput : reads >
AnalyticsAssembler ..> AnalyticsData : builds >
PdfGeneratorService ..> AnalyticsData : renders >
PdfGeneratorService ..> PdfReportOptions : uses >

@enduml
