@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

title Analytics — Presentation layer (nutrismart-webapp)

' ─── Boundary stubs: application layer ───────────────────────────────────────
package "analytics/application [boundary]" {
  class AnalyticsStore <<store>>
}

package "analytics/presentation/views" {
  class AnalyticsDashboardComponent <<@Component view>> {
    # analyticsStore: AnalyticsStore
    - translate: TranslateService
  }
  class ExportPdfReportViewComponent <<@Component view>>
}

package "analytics/presentation/components" {
  class AdherenceHistoryTimelineComponent <<@Component>>
  class AverageMacrosPanelComponent <<@Component>>
  class BehavioralEventsListComponent <<@Component>>
  class DailyCaloriesChartComponent <<@Component>>
  class ExportPdfButtonComponent <<@Component>>
  class MetricCardComponent <<@Component>>
  class PeriodToggleComponent <<@Component>>
  class WeightEvolutionChartComponent <<@Component>>
}

package "analytics/presentation [routes]" {
  class AnalyticsRoutes <<routes>>
}

' ─── Relationships ────────────────────────────────────────────────────────────
AnalyticsDashboardComponent --> AnalyticsStore : uses >
ExportPdfReportViewComponent --> AnalyticsStore : uses >

AnalyticsDashboardComponent *--> AdherenceHistoryTimelineComponent : composes >
AnalyticsDashboardComponent *--> AverageMacrosPanelComponent : composes >
AnalyticsDashboardComponent *--> BehavioralEventsListComponent : composes >
AnalyticsDashboardComponent *--> DailyCaloriesChartComponent : composes >
AnalyticsDashboardComponent *--> MetricCardComponent : composes >
AnalyticsDashboardComponent *--> PeriodToggleComponent : composes >
AnalyticsDashboardComponent *--> WeightEvolutionChartComponent : composes >
AnalyticsDashboardComponent *--> ExportPdfButtonComponent : composes >
ExportPdfReportViewComponent *--> ExportPdfButtonComponent : composes >

AnalyticsRoutes ..> AnalyticsDashboardComponent : routes to >
AnalyticsRoutes ..> ExportPdfReportViewComponent : routes to >

@enduml
