@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

title Behavioral Consistency — Application layer (nutrismart-webapp)

' ─── Boundary stubs: domain & infrastructure ─────────────────────────────────
package "behavioral-consistency/domain [boundary]" {
  class BehavioralProgress <<entity>>
  class EatingBehaviorPattern <<entity>>
  class RecoveryPlan <<entity>>
  enum BehaviorPatternType
}
package "behavioral-consistency/infrastructure [boundary]" {
  class BehavioralConsistencyApi <<api>>
  class EatingBehaviorPatternApi <<api>>
  class RecoveryPlanApi <<api>>
}
package "shared/application [boundary]" {
  class DomainEventBus <<event bus>>
  class NotificationService <<service>>
}

package "behavioral-consistency/application" {
  class BehavioralConsistencyStore <<@Injectable store>> {
    - behavioralConsistencyApi: BehavioralConsistencyApi
    - eatingBehaviorPatternApi: EatingBehaviorPatternApi
    - recoveryPlanApi: RecoveryPlanApi
    - eventBus: DomainEventBus
    - notificationService: NotificationService
    --
    + currentProgress: Signal<BehavioralProgress | null>
    + currentPattern: Signal<EatingBehaviorPattern | null>
    + activeRecoveryPlan: Signal<RecoveryPlan | null>
    + loading: Signal<boolean>
    + error: Signal<string | null>
    + patternType: Signal<BehaviorPatternType | null>
    + isPatternImproving: Signal<boolean>
    + isPatternDeclining: Signal<boolean>
  }
}

' ─── Relationships ────────────────────────────────────────────────────────────
BehavioralConsistencyStore --> BehavioralConsistencyApi : uses >
BehavioralConsistencyStore --> EatingBehaviorPatternApi : uses >
BehavioralConsistencyStore --> RecoveryPlanApi : uses >
BehavioralConsistencyStore --> DomainEventBus : subscribes >
BehavioralConsistencyStore --> NotificationService : notifies via >
BehavioralConsistencyStore ..> BehavioralProgress : holds >
BehavioralConsistencyStore ..> EatingBehaviorPattern : holds >
BehavioralConsistencyStore ..> RecoveryPlan : holds >
BehavioralConsistencyStore ..> BehaviorPatternType : derives >

@enduml
