@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

title Behavioral Consistency — Infrastructure layer (nutrismart-webapp)

' ─── Boundary stubs: domain layer ────────────────────────────────────────────
package "behavioral-consistency/domain [boundary]" {
  class BehavioralProgress <<entity>>
  class EatingBehaviorPattern <<entity>>
  class RecoveryPlan <<entity>>
}
package "shared/infrastructure [external]" {
  class BaseApi
  class BaseApiEndpoint
  interface BaseAssembler
  interface BaseResource
}

package "behavioral-consistency/infrastructure" {
  class BehavioralConsistencyApi <<@Injectable>> {
    + getBehavioralProgressByUserId(userId): Observable<BehavioralProgress | undefined>
    + createBehavioralProgress(p): Observable<BehavioralProgress>
    + updateBehavioralProgress(p, goalMetToday): Observable<BehavioralProgress>
    + deleteBehavioralProgress(id): Observable<void>
  }
  class EatingBehaviorPatternApi <<@Injectable>> {
    + getByUserId(userId): Observable<EatingBehaviorPattern | undefined>
    + create(pattern): Observable<EatingBehaviorPattern>
    + update(pattern): Observable<EatingBehaviorPattern>
  }
  class RecoveryPlanApi <<@Injectable>> {
    + getActiveByUserId(userId): Observable<RecoveryPlan | undefined>
    + create(plan): Observable<RecoveryPlan>
    + update(plan): Observable<RecoveryPlan>
  }
  class BehavioralConsistencyApiEndpoint <<endpoint>>
  class EatingBehaviorPatternApiEndpoint <<endpoint>>
  class RecoveryPlanApiEndpoint <<endpoint>>
  class BehavioralProgressAssembler <<assembler>>
  class EatingBehaviorPatternAssembler <<assembler>>
  class RecoveryPlanAssembler <<assembler>>
  interface BehavioralProgressResource <<resource>>
  interface EatingBehaviorPatternResource <<resource>>
  interface RecoveryPlanResource <<resource>>
}

' ─── Relationships ────────────────────────────────────────────────────────────
BehavioralConsistencyApi --|> BaseApi
EatingBehaviorPatternApi --|> BaseApi
RecoveryPlanApi --|> BaseApi
BehavioralConsistencyApiEndpoint --|> BaseApiEndpoint
EatingBehaviorPatternApiEndpoint --|> BaseApiEndpoint
RecoveryPlanApiEndpoint --|> BaseApiEndpoint
BehavioralProgressAssembler ..|> BaseAssembler
EatingBehaviorPatternAssembler ..|> BaseAssembler
RecoveryPlanAssembler ..|> BaseAssembler
BehavioralProgressResource --|> BaseResource
EatingBehaviorPatternResource --|> BaseResource
RecoveryPlanResource --|> BaseResource

BehavioralConsistencyApi --> BehavioralConsistencyApiEndpoint : via >
EatingBehaviorPatternApi --> EatingBehaviorPatternApiEndpoint : via >
RecoveryPlanApi --> RecoveryPlanApiEndpoint : via >
BehavioralConsistencyApiEndpoint --> BehavioralProgressAssembler : maps via >
EatingBehaviorPatternApiEndpoint --> EatingBehaviorPatternAssembler : maps via >
RecoveryPlanApiEndpoint --> RecoveryPlanAssembler : maps via >

BehavioralProgressAssembler ..> BehavioralProgress : builds >
BehavioralProgressAssembler ..> BehavioralProgressResource : reads/writes >
EatingBehaviorPatternAssembler ..> EatingBehaviorPattern : builds >
EatingBehaviorPatternAssembler ..> EatingBehaviorPatternResource : reads/writes >
RecoveryPlanAssembler ..> RecoveryPlan : builds >
RecoveryPlanAssembler ..> RecoveryPlanResource : reads/writes >

@enduml
