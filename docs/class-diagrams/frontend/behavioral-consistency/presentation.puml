@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

title Behavioral Consistency — Presentation layer (nutrismart-webapp)

' ─── Boundary stubs: application layer ───────────────────────────────────────
package "behavioral-consistency/application [boundary]" {
  class BehavioralConsistencyStore <<store>>
}
package "iam/application [boundary]" {
  class IamStore <<store>>
}

package "behavioral-consistency/presentation/views" {
  class BehavioralDashboard <<@Component view>> {
    - router: Router
    - translateService: TranslateService
    - iamStore: IamStore
  }
}

package "behavioral-consistency/presentation/components" {
  class AdherenceStatusCard <<@Component>>
  class BehavioralActionPanel <<@Component>>
  class BehavioralSummaryCard <<@Component>>
  class ConsistencyWeekStrip <<@Component>>
  class ReEngagementCard <<@Component>>
  class StreakCard <<@Component>>
}

package "behavioral-consistency/presentation [routes]" {
  class BehavioralConsistencyRoutes <<routes>>
}

' ─── Relationships ────────────────────────────────────────────────────────────
BehavioralDashboard --> BehavioralConsistencyStore : uses >
BehavioralDashboard --> IamStore : uses >

BehavioralDashboard *--> AdherenceStatusCard : composes >
BehavioralDashboard *--> BehavioralActionPanel : composes >
BehavioralDashboard *--> BehavioralSummaryCard : composes >
BehavioralDashboard *--> ConsistencyWeekStrip : composes >
BehavioralDashboard *--> ReEngagementCard : composes >
BehavioralDashboard *--> StreakCard : composes >

BehavioralConsistencyRoutes ..> BehavioralDashboard : routes to >

@enduml
