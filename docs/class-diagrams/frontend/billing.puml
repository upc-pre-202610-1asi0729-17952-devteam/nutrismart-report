@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "billing/domain/model" {
  class Subscription {
    + id: string
    + planType: PlanType
    + status: SubscriptionStatus
    + currentPeriodEnd: string
    + isPremium: boolean
    + isActive(): boolean
    + getDaysRemaining(): number
  }
  class Invoice {
    + id: string
    + amount: number
    + currency: string
    + status: InvoiceStatus
    + createdAt: string
    + paidAt: string
    + getFormattedAmount(): string
  }
  class PlanOption {
    + type: PlanType
    + label: string
    + priceMonthly: number
    + features: string[]
    + isPopular: boolean
  }
  enum PlanType {
    FREE
    PREMIUM_MONTHLY
    PREMIUM_ANNUAL
  }
  enum SubscriptionStatus {
    ACTIVE
    CANCELED
    PAST_DUE
    TRIALING
  }
  enum InvoiceStatus {
    PENDING
    PAID
    FAILED
    REFUNDED
  }
}

package "billing/application/services" {
  class SubscriptionService {
    - api: BillingApiService
    + currentSubscription: WritableSignal<Subscription | null>
    + invoices: WritableSignal<Invoice[]>
    + isLoading: WritableSignal<boolean>
    + isProcessing: WritableSignal<boolean>
    + loadSubscription(userId: string): Observable<Subscription>
    + subscribe(userId: string, planType: string, paymentMethodId: string): Observable<Subscription>
    + cancel(userId: string): Observable<Subscription>
    + loadInvoices(userId: string): Observable<Invoice[]>
  }
}

package "billing/infrastructure/http" {
  class BillingApiService {
    - http: HttpClient
    + getSubscription(userId: string): Observable<Subscription>
    + postCreateSubscription(userId: string, body: CreateSubBody): Observable<Subscription>
    + deleteCancelSubscription(userId: string): Observable<Subscription>
    + getInvoices(userId: string): Observable<Invoice[]>
  }
  class CreateSubBody {
    + planType: string
    + paymentMethodId: string
  }
  class StripeElementsService {
    + stripe: Stripe | null
    + elements: StripeElements | null
    + initialize(publishableKey: string): void
    + createCardElement(): StripeCardElement
    + confirmPayment(clientSecret: string): Promise<PaymentIntentResult>
  }
}

package "billing/presentation/components" {
  class "«Component»\nSubscriptionPageComponent" as SubscriptionPageComponent {
    - subscriptionService: SubscriptionService
    + currentSubscription: Signal<Subscription | null>
    + invoices: Signal<Invoice[]>
    + availablePlans: PlanOption[]
    + isLoading: Signal<boolean>
  }
  class "«Component»\nPlanCardComponent" as PlanCardComponent {
    + plan: InputSignal<PlanOption>
    + isCurrentPlan: InputSignal<boolean>
    + planSelected: EventEmitter<PlanOption>
    + onSelect(): void
  }
  class "«Component»\nCheckoutDialogComponent" as CheckoutDialogComponent {
    - subscriptionService: SubscriptionService
    - stripeService: StripeElementsService
    + selectedPlan: PlanOption
    + isProcessing: WritableSignal<boolean>
    + errorMessage: WritableSignal<string>
    + onSubmit(): Promise<void>
    + onCancel(): void
  }
  class "«Component»\nCurrentPlanCardComponent" as CurrentPlanCardComponent {
    - subscriptionService: SubscriptionService
    + subscription: Signal<Subscription | null>
    + daysRemaining: Signal<number>
    + statusColor: Signal<string>
    + onCancel(): void
  }
  class "«Component»\nInvoiceListComponent" as InvoiceListComponent {
    + invoices: InputSignal<Invoice[]>
    + onDownload(invoiceId: string): void
  }
}

SubscriptionService --> BillingApiService : uses >
SubscriptionService --> "1" Subscription : holds >
SubscriptionService --> "0..*" Invoice : holds >
Subscription "1" *--> "1" PlanType : has >
Subscription "1" *--> "1" SubscriptionStatus : has >
Invoice "1" *--> "1" InvoiceStatus : has >

SubscriptionPageComponent --> SubscriptionService : uses >
SubscriptionPageComponent o--> "1..*" PlanCardComponent : renders >
SubscriptionPageComponent o--> "1" CurrentPlanCardComponent : contains >
SubscriptionPageComponent o--> "1" InvoiceListComponent : contains >
PlanCardComponent ..> PlanOption : displays >
CheckoutDialogComponent --> SubscriptionService : uses >
CheckoutDialogComponent --> StripeElementsService : uses >
CurrentPlanCardComponent --> SubscriptionService : uses >
CurrentPlanCardComponent ..> Subscription : displays >
InvoiceListComponent ..> Invoice : renders >

@enduml