@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "bodymetrics/domain/model" {
  class BodyProfile {
    + userId: string
    + weightKg: number
    + heightCm: number
    + bmi: number
    + tdee: number
    + dailyCalorieTarget: number
    + goal: GoalType
    + targetWeightKg: number
    + biologicalSex: string
    + activityLevel: string
    + getBmiCategory(): string
    + getCalorieDeficit(): number
  }
  class WeightRecord {
    + weightKg: number
    + recordedAt: string
    + note: string
  }
  enum GoalType {
    LOSE_WEIGHT
    GAIN_MUSCLE
    MAINTAIN
  }
}

package "bodymetrics/application/services" {
  class BodyMetricsService {
    - api: BodyMetricsApiService
    + bodyProfile: WritableSignal<BodyProfile | null>
    + weightHistory: WritableSignal<WeightRecord[]>
    + isLoading: WritableSignal<boolean>
    + loadProfile(userId: string): Observable<BodyProfile>
    + initializeProfile(data: InitProfileRequest): Observable<BodyProfile>
    + logWeight(userId: string, weightKg: number, note: string): Observable<WeightRecord>
    + updateGoal(userId: string, goal: GoalType, targetWeight: number): Observable<BodyProfile>
    + loadWeightHistory(userId: string): Observable<WeightRecord[]>
  }
  class InitProfileRequest {
    + weightKg: number
    + heightCm: number
    + birthDate: string
    + biologicalSex: string
    + activityLevel: string
  }
}

package "bodymetrics/infrastructure/http" {
  class BodyMetricsApiService {
    - http: HttpClient
    + getProfile(userId: string): Observable<BodyProfile>
    + postInitProfile(userId: string, body: InitProfileRequest): Observable<BodyProfile>
    + postLogWeight(userId: string, weightKg: number, note: string): Observable<WeightRecord>
    + putGoal(userId: string, goal: string, targetWeightKg: number): Observable<BodyProfile>
    + getWeightHistory(userId: string): Observable<WeightRecord[]>
  }
}

package "bodymetrics/presentation/components" {
  class "«Component»\nBodyProfileComponent" as BodyProfileComponent {
    - metricsService: BodyMetricsService
    + bodyProfile: Signal<BodyProfile | null>
    + bmiCategory: Signal<string>
    + onInitialize(data: InitProfileRequest): void
  }
  class "«Component»\nWeightLogComponent" as WeightLogComponent {
    - metricsService: BodyMetricsService
    + weightHistory: Signal<WeightRecord[]>
    + logForm: FormGroup
    + isLoading: WritableSignal<boolean>
    + onLogWeight(): void
  }
  class "«Component»\nWeightChartComponent" as WeightChartComponent {
    + records: InputSignal<WeightRecord[]>
    + targetWeight: InputSignal<number>
    + chartData: Signal<ChartDataset[]>
  }
  class "«Component»\nGoalSettingComponent" as GoalSettingComponent {
    - metricsService: BodyMetricsService
    + goalForm: FormGroup
    + goalTypes: GoalType[]
    + onSaveGoal(): void
  }
  class "«Component»\nBmiIndicatorComponent" as BmiIndicatorComponent {
    + bmi: InputSignal<number>
    + category: InputSignal<string>
    + progressValue: Signal<number>
  }
  class ChartDataset {
    + labels: string[]
    + data: number[]
    + borderColor: string
  }
}

BodyMetricsService --> BodyMetricsApiService : uses >
BodyMetricsService --> "1" BodyProfile : holds >
BodyMetricsService --> "0..*" WeightRecord : tracks >
BodyProfile "1" *--> "1" GoalType : has >

BodyProfileComponent --> BodyMetricsService : uses >
BodyProfileComponent --> "1" BodyProfile : displays >
WeightLogComponent --> BodyMetricsService : uses >
WeightLogComponent --> "0..*" WeightRecord : shows >
WeightChartComponent ..> WeightRecord : reads >
WeightChartComponent --> "1" ChartDataset : produces >
GoalSettingComponent --> BodyMetricsService : uses >
BmiIndicatorComponent ..> BodyProfile : reads bmi >

@enduml