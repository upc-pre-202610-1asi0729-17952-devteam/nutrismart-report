@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "iam/domain/model" {
  class User {
    + id: string
    + email: string
    + firstName: string
    + lastName: string
    + role: UserRole
    + avatarUrl: string
    + getFullName(): string
    + isPremium(): boolean
  }
  enum UserRole {
    FREE
    PREMIUM
    ADMIN
  }
}

package "iam/application/services" {
  class AuthService {
    - http: HttpClient
    - currentUser: WritableSignal<User | null>
    + currentUser: Signal<User | null>
    + isAuthenticated: Signal<boolean>
    + login(email: string, password: string): Observable<string>
    + register(data: RegisterData): Observable<User>
    + logout(): void
    + getProfile(): Observable<User>
    + refreshCurrentUser(): void
  }
  class RegisterData {
    + email: string
    + password: string
    + firstName: string
    + lastName: string
  }
}

package "iam/infrastructure/http" {
  class IamApiService {
    - http: HttpClient
    + postLogin(email: string, password: string): Observable<{token: string}>
    + postRegister(data: RegisterData): Observable<User>
    + getProfile(): Observable<User>
    + putProfile(data: Partial<User>): Observable<User>
  }
  class AuthInterceptor {
    + intercept(req: HttpRequest<any>, next: HttpHandler): Observable<HttpEvent<any>>
    - getToken(): string | null
  }
  class AuthGuard {
    - authService: AuthService
    - router: Router
    + canActivate(route: ActivatedRouteSnapshot): boolean | UrlTree
  }
  class PremiumGuard {
    - authService: AuthService
    - router: Router
    + canActivate(): boolean | UrlTree
  }
}


package "iam/presentation/components" {
  class "«Component»\nLoginComponent" as LoginComponent {
    - authService: AuthService
    - router: Router
    + loginForm: FormGroup
    + isLoading: boolean
    + errorMessage: string
    + onSubmit(): void
    + navigateToRegister(): void
  }
  class "«Component»\nRegisterComponent" as RegisterComponent {
    - authService: AuthService
    - router: Router
    + registerForm: FormGroup
    + isLoading: boolean
    + errorMessage: string
    + onSubmit(): void
  }
  class "«Component»\nUserProfileComponent" as UserProfileComponent {
    - authService: AuthService
    + currentUser: Signal<User | null>
    + profileForm: FormGroup
    + isEditing: WritableSignal<boolean>
    + onSave(): void
    + onCancel(): void
  }
  class "«Component»\nNavbarComponent" as NavbarComponent {
    - authService: AuthService
    - router: Router
    + currentUser: Signal<User | null>
    + isAuthenticated: Signal<boolean>
    + onLogout(): void
  }
}

AuthService --> IamApiService : uses >
AuthService --> "1" User : manages >
AuthInterceptor --> AuthService : reads token from >
AuthGuard --> AuthService : checks >
PremiumGuard --> AuthService : checks >

LoginComponent --> AuthService : uses >
RegisterComponent --> AuthService : uses >
UserProfileComponent --> AuthService : uses >
UserProfileComponent --> "1" User : displays >
NavbarComponent --> AuthService : uses >

@enduml