@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

title IAM — Application layer (nutrismart-webapp)

' ─── Boundary stubs: domain & infrastructure ─────────────────────────────────
package "iam/domain [boundary]" {
  class User <<entity>>
  enum UserGoal
  enum ActivityLevel
  enum DietaryRestriction
  enum MedicalCondition
}
package "iam/infrastructure [boundary]" {
  class IamApi <<api>>
}
package "shared/application [boundary]" {
  class DomainEventBus <<event bus>>
}

package "iam/application" {

  class IamStore <<@Injectable store>> {
    - iamApi: IamApi
    - router: Router
    - eventBus: DomainEventBus
    --
    + currentUser: Signal<User | null>
    + isAuthenticated: Signal<boolean>
    + loading: Signal<boolean>
    + error: Signal<string | null>
    --
    + login(email, password): Observable<User>
    + logout(): void
    + updatePhysicalDetails(w, h, level: ActivityLevel): void
    + updateWeightOnly(weightKg): void
    + changeGoal(goal: UserGoal): void
    + addRestriction(r: DietaryRestriction): void
    + removeRestriction(r: DietaryRestriction): void
    + setRestrictions(restrictions: DietaryRestriction[]): void
    + addMedicalConditionEnum(c: MedicalCondition): void
    + removeMedicalCondition(c: string): void
    - saveSession(user: User): void
    - clearSession(): void
    - restoreSession(): void
    - subscribeToMetabolicTargets(): void
  }

  class authGuard <<CanActivateFn>>
  class onboardingGuard <<CanActivateFn>>
  class planGuard <<CanActivateFn>>
  class subscriptionGuard <<CanActivateFn>>
}

' ─── Relationships ────────────────────────────────────────────────────────────
IamStore --> IamApi : uses >
IamStore --> DomainEventBus : publishes/subscribes >
IamStore ..> User : holds state of >
IamStore ..> UserGoal : mutates >
IamStore ..> DietaryRestriction : mutates >
IamStore ..> MedicalCondition : mutates >
IamStore ..> ActivityLevel : updates >

authGuard ..> IamStore : checks session via >
onboardingGuard ..> IamStore : checks profile via >
planGuard ..> IamStore : checks plan via >
subscriptionGuard ..> IamStore : checks plan via >

@enduml
