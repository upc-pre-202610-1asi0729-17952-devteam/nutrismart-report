@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

title IAM — Infrastructure layer (nutrismart-webapp)

' ─── Boundary stubs: domain layer ────────────────────────────────────────────
package "iam/domain [boundary]" {
  class User <<entity>>
}

' ─── Shared kernel (generic infrastructure) ──────────────────────────────────
package "shared/infrastructure [external]" {
  class BaseApi
  class BaseApiEndpoint
  interface BaseAssembler
  interface BaseResource
  interface BaseResponse
}

package "iam/infrastructure" {

  class IamApi <<@Injectable>> {
    - http: HttpClient
    --
    + login(email, password): Observable<User>
    + checkEmail(email): Observable<{exists: boolean}>
    + getUsers(): Observable<User[]>
    + getUser(id): Observable<User>
    + createUser(user: User, password?): Observable<User>
    + updateUser(user: User): Observable<User>
    + deleteUser(id): Observable<void>
    + forgotPassword(email): Observable<void>
    + resetPassword(token, newPassword): Observable<void>
  }

  class IamApiEndpoint <<endpoint>>

  class UserAssembler <<assembler>> {
    + toEntityFromResource(resource: UserResource): User
    + toResourceFromEntity(entity: User): UserResource
    + toEntitiesFromResponse(response: UsersResponse): User[]
  }

  interface UserResource <<resource>>
  interface UsersResponse <<response>>
  interface LoginResponse <<response>>
}

' ─── Relationships ────────────────────────────────────────────────────────────
IamApi --|> BaseApi
IamApiEndpoint --|> BaseApiEndpoint
UserAssembler ..|> BaseAssembler
UserResource --|> BaseResource
UsersResponse --|> BaseResponse

IamApi --> UserAssembler : maps via >
IamApi ..> User : returns >
UserAssembler ..> User : builds >
UserAssembler ..> UserResource : reads/writes >
UserAssembler ..> UsersResponse : reads >
IamApiEndpoint ..> UserResource : transports >
IamApi ..> LoginResponse : receives >

@enduml
