@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

title IAM — Presentation layer (nutrismart-webapp)

' ─── Boundary stubs: application & infrastructure ────────────────────────────
package "iam/application [boundary]" {
  class IamStore <<store>>
  class authGuard <<guard>>
  class onboardingGuard <<guard>>
}
package "iam/infrastructure [boundary]" {
  class IamApi <<api>>
}
package "shared/infrastructure [boundary]" {
  class CityLookupApi <<api>>
}

package "iam/presentation/views" {
  class Login <<@Component view>> {
    - iamStore: IamStore
    - router: Router
    - fb: FormBuilder
    + onSubmit(): void
  }
  class Register <<@Component view>> {
    - iamStore: IamStore
    - iamApi: IamApi
    + onSubmit(): void
  }
  class ForgotPassword <<@Component view>> {
    - iamApi: IamApi
    + onSubmit(): void
  }
  class ResetPassword <<@Component view>> {
    - iamApi: IamApi
    - route: ActivatedRoute
  }
  class Onboarding <<@Component view>> {
    + iamStore: IamStore
    + metabolicStore: MetabolicStore
  }
  class Profile <<@Component view>> {
    + iamStore: IamStore
    - cityLookupApi: CityLookupApi
  }
  class Subscription <<@Component view>> {
    - iamStore: IamStore
    + isSetupMode: boolean
  }
}

package "iam/presentation [routes]" {
  class IamRoutes <<routes>>
  class OnboardingRoutes <<routes>>
  class ProfileRoutes <<routes>>
}

' ─── Relationships ────────────────────────────────────────────────────────────
Login --> IamStore : uses >
Register --> IamStore : uses >
Register --> IamApi : uses >
ForgotPassword --> IamApi : uses >
ResetPassword --> IamApi : uses >
Onboarding --> IamStore : uses >
Profile --> IamStore : uses >
Profile --> CityLookupApi : uses >
Subscription --> IamStore : uses >

IamRoutes ..> Login : routes to >
IamRoutes ..> Register : routes to >
IamRoutes ..> ForgotPassword : routes to >
IamRoutes ..> ResetPassword : routes to >
IamRoutes ..> authGuard : guarded by >
OnboardingRoutes ..> Onboarding : routes to >
OnboardingRoutes ..> onboardingGuard : guarded by >
ProfileRoutes ..> Profile : routes to >
ProfileRoutes ..> Subscription : routes to >

@enduml
