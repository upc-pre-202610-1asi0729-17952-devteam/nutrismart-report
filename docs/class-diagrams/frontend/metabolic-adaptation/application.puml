@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

' ─── Boundary stubs: infrastructure ─────────────────────────────────────────
package "metabolic-adaptation/infrastructure [boundary]" {
  class MetabolicApi <<boundary>> {
  }
  class WearableApi <<boundary>> {
  }
}

' ─── Boundary stubs: domain ──────────────────────────────────────────────────
package "metabolic-adaptation/domain [boundary]" {
  class BodyMetric <<boundary>> {
  }
  class BodyComposition <<boundary>> {
  }
  class NutritionPlan <<boundary>> {
  }
  class WearableConnection <<boundary>> {
  }
  class ActivityLog <<boundary>> {
  }
}

' ─── Boundary stubs: shared ──────────────────────────────────────────────────
package "shared/application [boundary]" {
  class DomainEventBus <<boundary>> {
    + publish(event: DomainEvent): void
    + events$: Observable<DomainEvent>
  }
}

package "shared/domain [boundary]" {
  class MetabolicTargetSet <<boundary>> {
  }
  class WeightLogged <<boundary>> {
  }
  class TargetWeightSet <<boundary>> {
  }
  class BodyMetricsUpdated <<boundary>> {
  }
  class StagnationDetected <<boundary>> {
  }
  class GoalSwitched <<boundary>> {
  }
  class OnboardingCompleted <<boundary>> {
  }
  class ActivitySynced <<boundary>> {
  }
  class WearableConnected <<boundary>> {
  }
  class ActiveCaloriesCalculated <<boundary>> {
  }
}

' ─── Application ─────────────────────────────────────────────────────────────
package "metabolic-adaptation/application" {

  class MetabolicStore <<store>> {
    ' Writable signals
    - _currentMetric: WritableSignal<BodyMetric | null>
    - _metricsHistory: WritableSignal<BodyMetric[]>
    - _allHistory: WritableSignal<BodyMetric[]>
    - _composition: WritableSignal<BodyComposition | null>
    - _nutritionPlan: WritableSignal<NutritionPlan | null>
    - _selectedDays: WritableSignal<number>
    - _loading: WritableSignal<boolean>
    - _error: WritableSignal<string | null>
    - _adaptationHistory: WritableSignal<MetabolicAdaptationLog[]>
    ' Read-only signals
    + currentMetric: Signal<BodyMetric | null>
    + metricsHistory: Signal<BodyMetric[]>
    + composition: Signal<BodyComposition | null>
    + nutritionPlan: Signal<NutritionPlan | null>
    + selectedDays: Signal<number>
    + loading: Signal<boolean>
    + error: Signal<string | null>
    ' Computed signals
    + daysInCurrentGoal: Signal<number>
    + daysUntilUnlock: Signal<number>
    + isGoalLocked: Signal<boolean>
    + unlockDate: Signal<string>
    + isStale: Signal<boolean>
    + isMuscleGain: Signal<boolean>
    + hasLoggedToday: Signal<boolean>
    + hasStagnated: Signal<boolean>
    + recentHistory: Signal<BodyMetric[]>
    + chartPoints: Signal<ChartPoint[]>
    --
    + initialise(userId: number): Promise<void>
    + logWeight(weightKg: number): Promise<void>
    + setTargetWeight(targetKg: number): Promise<void>
    + loadHistory(): Promise<void>
    + loadAllHistory(): Promise<void>
    + setComposition(data: CompositionDto): Promise<void>
    + switchGoal(goal: UserGoal): Promise<void>
    + recalculateForGoal(goal: UserGoal): Promise<void>
    + applyInitialTarget(user: User): Promise<void>
    + runDailyStagnationCheck(): void
    + publishMetabolicTargetSet(plan: NutritionPlan): void
    + checkAndPublishStagnation(): void
  }

  class WearableStore <<store>> {
    ' Writable signals
    - _connection: WritableSignal<WearableConnection | null>
    - _activityLogs: WritableSignal<ActivityLog[]>
    - _estimatedCalories: WritableSignal<number>
    - _loading: WritableSignal<boolean>
    - _error: WritableSignal<string | null>
    - _stagnationSuggestion: WritableSignal<string | null>
    - _activitySuggestionForRecovery: WritableSignal<string | null>
    - _premiumEnabled: WritableSignal<boolean>
    ' Read-only signals
    + connection: Signal<WearableConnection | null>
    + activityLogs: Signal<ActivityLog[]>
    + estimatedCalories: Signal<number>
    + loading: Signal<boolean>
    + error: Signal<string | null>
    + stagnationSuggestion: Signal<string | null>
    + activitySuggestionForRecovery: Signal<string | null>
    + premiumEnabled: Signal<boolean>
    ' Computed signals
    + netCalorieAdjustment: Signal<number>
    + netDailyTarget: Signal<number>
    + todayLogs: Signal<ActivityLog[]>
    + weekLogs: Signal<ActivityLog[]>
    + activityTypeKeys: Signal<string[]>
    + recentLogs: Signal<ActivityLog[]>
    --
    + load(userId: number): Promise<void>
    + connectGoogleFit(userId: number, token: string): Promise<void>
    + disconnectWearable(userId: number): Promise<void>
    + syncNow(userId: number): Promise<void>
    + previewCalories(durationMin: number, type: string): number
    + logManualActivity(data: ManualActivityDto): Promise<void>
    + analyzeWeeklyTrend(): void
  }
}

' ─── Dependencies ────────────────────────────────────────────────────────────
MetabolicStore o--> MetabolicApi : uses >
MetabolicStore o--> DomainEventBus : uses >
WearableStore o--> WearableApi : uses >
WearableStore o--> DomainEventBus : uses >

MetabolicStore ..> BodyMetric : manages >
MetabolicStore ..> BodyComposition : tracks >
MetabolicStore ..> NutritionPlan : manages >
WearableStore ..> WearableConnection : manages >
WearableStore ..> ActivityLog : logs >

' ─── Published events ────────────────────────────────────────────────────────
MetabolicStore ..> MetabolicTargetSet : publishes >
MetabolicStore ..> WeightLogged : publishes >
MetabolicStore ..> TargetWeightSet : publishes >
MetabolicStore ..> BodyMetricsUpdated : publishes >
MetabolicStore ..> StagnationDetected : publishes >
WearableStore ..> ActivitySynced : publishes >
WearableStore ..> WearableConnected : publishes >
WearableStore ..> ActiveCaloriesCalculated : publishes >

' ─── Subscribed events ───────────────────────────────────────────────────────
OnboardingCompleted ..> MetabolicStore : triggers applyInitialTarget >
GoalSwitched ..> MetabolicStore : triggers recalculation >
StagnationDetected ..> WearableStore : triggers activity suggestion >

@enduml
