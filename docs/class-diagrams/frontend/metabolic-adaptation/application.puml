@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

title Metabolic Adaptation — Application layer (nutrismart-webapp)

' ─── Boundary stubs: domain & infrastructure ─────────────────────────────────
package "metabolic-adaptation/domain [boundary]" {
  class BodyMetric <<entity>>
  class NutritionPlan <<entity>>
  class MetabolicAdaptationLog <<entity>>
  class WearableConnection <<entity>>
  class ActivityLog <<entity>>
  class ActivityType <<value object>>
}
package "metabolic-adaptation/infrastructure [boundary]" {
  class MetabolicApi <<api>>
  class MetabolicAdaptationLogApi <<api>>
  class WearableApi <<api>>
}
package "<<other contexts>> [external]" {
  class IamStore <<iam>>
  class DomainEventBus <<shared>>
}

package "metabolic-adaptation/application" {
  class MetabolicStore <<@Injectable store>> {
    - api: MetabolicApi
    - adaptationLogApi: MetabolicAdaptationLogApi
    - iamStore: IamStore
    - eventBus: DomainEventBus
    --
    + daysInCurrentGoal: Signal<number>
    + daysUntilUnlock: Signal<number>
    + unlockDate: Signal<string>
    + significantAdaptations: Signal<MetabolicAdaptationLog[]>
    + isMuscleGain: Signal<boolean>
    + hasLoggedToday: Signal<boolean>
    + hasStagnated: Signal<boolean>
    + chartPoints: Signal<...>
  }
  class WearableStore <<@Injectable store>> {
    - api: WearableApi
    - iamStore: IamStore
    - eventBus: DomainEventBus
    --
    + netCalorieAdjustment: Signal<number>
    + netDailyTarget: Signal<number>
    + todayLogs: Signal<ActivityLog[]>
    + weekLogs: Signal<ActivityLog[]>
    + activityTypeKeys: Signal<string[]>
    + load(): Promise<void>
    + connectGoogleFit(): Promise<void>
    + disconnectWearable(): Promise<void>
    + syncNow(): Promise<void>
  }
  class bodyProgressGoalGuard <<CanActivateFn>>
}

' ─── Relationships ────────────────────────────────────────────────────────────
MetabolicStore --> MetabolicApi : uses >
MetabolicStore --> MetabolicAdaptationLogApi : uses >
MetabolicStore --> IamStore : reads user >
MetabolicStore --> DomainEventBus : subscribes/publishes >
MetabolicStore ..> BodyMetric : holds >
MetabolicStore ..> NutritionPlan : computes >
MetabolicStore ..> MetabolicAdaptationLog : holds >

WearableStore --> WearableApi : uses >
WearableStore --> IamStore : reads user >
WearableStore --> DomainEventBus : publishes >
WearableStore ..> WearableConnection : holds >
WearableStore ..> ActivityLog : holds >
WearableStore ..> ActivityType : reads keys >

bodyProgressGoalGuard ..> IamStore : checks goal via >

@enduml
