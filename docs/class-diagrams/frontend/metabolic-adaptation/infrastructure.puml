@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

title Metabolic Adaptation — Infrastructure layer (nutrismart-webapp)

' ─── Boundary stubs: domain layer ────────────────────────────────────────────
package "metabolic-adaptation/domain [boundary]" {
  class BodyMetric <<entity>>
  class BodyComposition <<entity>>
  class WearableConnection <<entity>>
  class ActivityLog <<entity>>
  class MetabolicAdaptationLog <<entity>>
}
package "shared/infrastructure [external]" {
  class BaseApi
  class BaseApiEndpoint
  interface BaseAssembler
  interface BaseResource
}

package "metabolic-adaptation/infrastructure" {
  class MetabolicApi <<@Injectable>>
  class MetabolicAdaptationLogApi <<@Injectable>>
  class WearableApi <<@Injectable>>

  class BodyMetricEndpoint <<endpoint>>
  class BodyCompositionEndpoint <<endpoint>>
  class MetabolicAdaptationLogApiEndpoint <<endpoint>>
  class WearableConnectionEndpoint <<endpoint>>
  class ActivityLogEndpoint <<endpoint>>

  class BodyMetricAssembler <<assembler>>
  class BodyCompositionAssembler <<assembler>>
  class MetabolicAdaptationLogAssembler <<assembler>>
  class WearableConnectionAssembler <<assembler>>
  class ActivityLogAssembler <<assembler>>

  interface BodyMetricResource <<resource>>
  interface BodyCompositionResource <<resource>>
  interface NutritionPlanResource <<resource>>
  interface MetabolicAdaptationLogResource <<resource>>
  interface WearableConnectionResource <<resource>>
  interface ActivityLogResource <<resource>>
}

' (response interfaces extend shared BaseResponse — omitted for brevity)

' ─── Relationships ────────────────────────────────────────────────────────────
MetabolicApi --|> BaseApi
MetabolicAdaptationLogApi --|> BaseApi
WearableApi --|> BaseApi
BodyMetricEndpoint --|> BaseApiEndpoint
BodyCompositionEndpoint --|> BaseApiEndpoint
MetabolicAdaptationLogApiEndpoint --|> BaseApiEndpoint
WearableConnectionEndpoint --|> BaseApiEndpoint
ActivityLogEndpoint --|> BaseApiEndpoint
BodyMetricAssembler ..|> BaseAssembler
BodyCompositionAssembler ..|> BaseAssembler
MetabolicAdaptationLogAssembler ..|> BaseAssembler
WearableConnectionAssembler ..|> BaseAssembler
ActivityLogAssembler ..|> BaseAssembler
BodyMetricResource --|> BaseResource
WearableConnectionResource --|> BaseResource

MetabolicApi --> BodyMetricEndpoint : via >
MetabolicApi --> BodyCompositionEndpoint : via >
MetabolicAdaptationLogApi --> MetabolicAdaptationLogApiEndpoint : via >
WearableApi --> WearableConnectionEndpoint : via >
WearableApi --> ActivityLogEndpoint : via >

BodyMetricEndpoint --> BodyMetricAssembler : maps via >
BodyCompositionEndpoint --> BodyCompositionAssembler : maps via >
MetabolicAdaptationLogApiEndpoint --> MetabolicAdaptationLogAssembler : maps via >
WearableConnectionEndpoint --> WearableConnectionAssembler : maps via >
ActivityLogEndpoint --> ActivityLogAssembler : maps via >

BodyMetricAssembler ..> BodyMetric : builds >
BodyMetricAssembler ..> BodyMetricResource : reads/writes >
BodyCompositionAssembler ..> BodyComposition : builds >
BodyCompositionAssembler ..> BodyCompositionResource : reads/writes >
MetabolicAdaptationLogAssembler ..> MetabolicAdaptationLog : builds >
WearableConnectionAssembler ..> WearableConnection : builds >
ActivityLogAssembler ..> ActivityLog : builds >
ActivityLogAssembler ..> ActivityLogResource : reads/writes >
MetabolicAdaptationLogAssembler ..> MetabolicAdaptationLogResource : reads/writes >
MetabolicApi ..> NutritionPlanResource : transports >

@enduml
