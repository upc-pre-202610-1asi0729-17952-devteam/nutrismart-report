@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

package "metabolic-adaptation/domain/model" {

  enum BmiCategory {
    UNDERWEIGHT
    NORMAL
    OVERWEIGHT
    OBESE
  }

  enum MetabolicChangeTrigger {
    WEIGHT_LOGGED
    GOAL_SWITCHED
    ACTIVITY_SYNCED
    STAGNATION_DETECTED
    TARGET_WEIGHT_SET
    ONBOARDING_COMPLETED
    MANUAL_OVERRIDE
  }

  enum WearableStatus {
    DISCONNECTED
    CONNECTED
    SYNC_FAILED
  }

  class BodyMetric <<entity>> {
    - _id: number
    - _userId: number
    - _weightKg: number
    - _heightCm: number
    - _loggedAt: string
    - _targetWeightKg: number
    - _projectedAchievementDate: string | null
    --
    + bmi: number
    + bmiCategory: BmiCategory
    + bmr: number
    + tdee: number
    + isStale: boolean
    + daysSinceLogged: number
    --
    + calculateProjectedDate(goal: UserGoal): string | null
    + isValidWeightLossTarget(target: number): boolean
    + calculateDelta(): number
    + isProgressingToward(target: number): boolean
  }

  class BodyComposition <<entity>> {
    - _id: number
    - _userId: number
    - _waistCm: number
    - _neckCm: number
    - _heightCm: number
    - _weightKg: number
    - _measuredAt: string
    - _previousBodyFatPercent: number | null
    - _overrideBodyFatPercent: number | null
    --
    + bodyFatPercent: number
    + fatMassKg: number
    + leanMassKg: number
    --
    + hasFatIncreaseAlert(): boolean
  }

  class ActivityLog <<entity>> {
    - _id: number
    - _userId: number
    - _activityType: string
    - _durationMinutes: number
    - _caloriesBurned: number
    - _timestamp: string
    --
    + toNetAdjustment(): number
    + isFromToday(): boolean
  }

  class MetabolicAdaptationLog <<entity>> {
    - _id: number
    - _userId: number
    - _trigger: MetabolicChangeTrigger
    - _previousCalorieTarget: number
    - _newCalorieTarget: number
    - _previousProtein: number
    - _newProtein: number
    - _previousCarbs: number
    - _newCarbs: number
    - _previousFat: number
    - _newFat: number
    - _loggedAt: string
  }

  class NutritionPlan <<entity>> {
    - _id: number
    - _userId: number
    - _dailyCalorieTarget: number
    - _proteinTargetG: number
    - _carbsTargetG: number
    - _fatTargetG: number
    - _fiberTargetG: number
    - _isActive: boolean
    - _createdAt: string
    --
    + proteinCaloriePercent: number
    + carbsCaloriePercent: number
    + fatCaloriePercent: number
    --
    + isMacroBalanced(): boolean
    + summary(): string
    + {static} fromTargets(userId, targets): NutritionPlan
  }

  class WearableConnection <<entity>> {
    - _id: number
    - _userId: number
    - _provider: string
    - _status: WearableStatus
    - _lastSyncedAt: string
    - _authorizedAt: string
    --
    + isHealthy(): boolean
    + minutesSinceSync(): number
    + hoursSinceSync(): number
  }
}

package "metabolic-adaptation/domain/events" {

  class BmiCalculated <<domain event>> {
    + eventType: string
    + userId: number
    + bmi: number
    + category: BmiCategory
  }

  class BmrCalculated <<domain event>> {
    + eventType: string
    + userId: number
    + bmr: number
  }

  class TdeeCalculated <<domain event>> {
    + eventType: string
    + userId: number
    + tdee: number
  }

  class CaloricTargetAdjusted <<domain event>> {
    + eventType: string
    + userId: number
    + newTarget: number
    + trigger: MetabolicChangeTrigger
  }

  class ActivitySynced <<domain event>> {
    + eventType: string
    + userId: number
    + caloriesBurned: number
    + source: string
  }

  class WearableConnected <<domain event>> {
    + eventType: string
    + userId: number
    + provider: string
  }

  class StagnationDetected <<domain event>> {
    + eventType: string
    + userId: number
    + weeksWithoutProgress: number
  }

  class ActivityTrendDetected <<domain event>> {
    + eventType: string
    + userId: number
    + trendKey: string
  }

  class ManualActivityImported <<domain event>> {
    + eventType: string
    + userId: number
    + activityType: string
    + caloriesBurned: number
  }
}

BodyMetric "1" *--> "1" BmiCategory : categorized as >
WearableConnection "1" *--> "1" WearableStatus : has status >
MetabolicAdaptationLog "1" *--> "1" MetabolicChangeTrigger : triggered by >
CaloricTargetAdjusted ..> MetabolicChangeTrigger : carries >
BmiCalculated ..> BmiCategory : carries >

@enduml
