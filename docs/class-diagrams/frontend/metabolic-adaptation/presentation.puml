@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

title Metabolic Adaptation — Presentation layer (nutrismart-webapp)

' ─── Boundary stubs: application layer ───────────────────────────────────────
package "metabolic-adaptation/application [boundary]" {
  class MetabolicStore <<store>>
  class WearableStore <<store>>
}
package "iam/application [boundary]" {
  class IamStore <<store>>
}

package "metabolic-adaptation/presentation/views" {
  class BodyProgressView <<@Component view>> {
    # store: MetabolicStore
    # iamStore: IamStore
  }
  class GoalSelectionScreen <<@Component view>> {
    - iamStore: IamStore
    - metabolicStore: MetabolicStore
  }
  class PhysicalActivityView <<@Component view>> {
    # store: WearableStore
    # iamStore: IamStore
  }
  class WeightHistoryView <<@Component view>> {
    # store: MetabolicStore
  }
  class OAuthHealthCallbackView <<@Component view>> {
    # store: WearableStore
  }
}

package "metabolic-adaptation/presentation/components" {
  class ActivityHistoryPanel <<@Component>>
  class ActivityPaywallCard <<@Component>>
  class GoogleFitConnectCard <<@Component>>
  class ManualActivityCard <<@Component>>
  class ManualActivityModal <<@Component>>
  class SyncFailedBanner <<@Component>>
  class WearableChip <<@Component>>
  class WearableConnectedCard <<@Component>>
  class WearableSyncModal <<@Component>>
}

package "metabolic-adaptation/presentation [routes]" {
  class BodyProgressRoutes <<routes>>
  class WearableRoutes <<routes>>
}

' ─── Relationships ────────────────────────────────────────────────────────────
BodyProgressView --> MetabolicStore : uses >
BodyProgressView --> IamStore : uses >
GoalSelectionScreen --> MetabolicStore : uses >
GoalSelectionScreen --> IamStore : uses >
PhysicalActivityView --> WearableStore : uses >
PhysicalActivityView --> IamStore : uses >
WeightHistoryView --> MetabolicStore : uses >

PhysicalActivityView *--> ActivityHistoryPanel : composes >
PhysicalActivityView *--> ActivityPaywallCard : composes >
PhysicalActivityView *--> GoogleFitConnectCard : composes >
PhysicalActivityView *--> ManualActivityCard : composes >
PhysicalActivityView *--> ManualActivityModal : composes >
PhysicalActivityView *--> SyncFailedBanner : composes >
PhysicalActivityView *--> WearableChip : composes >
PhysicalActivityView *--> WearableConnectedCard : composes >
PhysicalActivityView *--> WearableSyncModal : composes >

OAuthHealthCallbackView --> WearableStore : uses >

BodyProgressRoutes ..> BodyProgressView : routes to >
BodyProgressRoutes ..> GoalSelectionScreen : routes to >
BodyProgressRoutes ..> WeightHistoryView : routes to >
WearableRoutes ..> PhysicalActivityView : routes to >
WearableRoutes ..> OAuthHealthCallbackView : routes to >

@enduml
