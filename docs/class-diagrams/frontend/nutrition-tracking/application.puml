@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

title Nutrition Tracking — Application layer (nutrismart-webapp)

' ─── Boundary stubs: domain & infrastructure ─────────────────────────────────
package "nutrition-tracking/domain [boundary]" {
  class FoodItem <<entity>>
  class MealRecord <<entity>>
  class DailyIntake <<entity>>
  class ScanResult <<entity>>
  enum MealType
  enum DietaryRestriction
}
package "nutrition-tracking/infrastructure [boundary]" {
  class NutritionApi <<api>>
  class PlateScanApi <<api>>
}
package "<<other contexts>> [external]" {
  class IamStore <<iam>>
  class WearableStore <<metabolic-adaptation>>
  class DomainEventBus <<shared>>
  class NotificationService <<shared>>
}

package "nutrition-tracking/application" {
  class NutritionStore <<@Injectable store>> {
    - nutritionApi: NutritionApi
    - iamStore: IamStore
    - notificationService: NotificationService
    - eventBus: DomainEventBus
    - wearableStore: WearableStore
    --
    + foodItems: Signal<FoodItem[]>
    + mealRecords: Signal<MealRecord[]>
    + dailyIntakes: Signal<DailyIntake[]>
    + searchQuery: Signal<string>
    + userRestrictions: Signal<DietaryRestriction[]>
    + goalExceededToday: Signal<boolean>
    + allMealsMetToday: Signal<boolean>
  }
  class PlateScanStore <<@Injectable store>> {
    - plateScanApi: PlateScanApi
    - iamStore: IamStore
    - nutritionStore: NutritionStore
    - eventBus: DomainEventBus
    --
    + totalEstimatedCalories: Signal<number>
    + hasScanItems: Signal<boolean>
    + macroAlerts: Signal<MacroAlert[]>
    + analyzePlatePhoto(imageBase64): Promise<void>
    + logScannedPlate(mealType: MealType): Promise<void>
    + updateScannedItemQuantity(itemId, newQuantity): void
  }
}

' ─── Relationships ────────────────────────────────────────────────────────────
NutritionStore --> NutritionApi : uses >
NutritionStore --> IamStore : reads user >
NutritionStore --> NotificationService : notifies via >
NutritionStore --> DomainEventBus : subscribes/publishes >
NutritionStore --> WearableStore : reads active kcal >
NutritionStore ..> FoodItem : holds >
NutritionStore ..> MealRecord : holds >
NutritionStore ..> DailyIntake : holds >
NutritionStore ..> DietaryRestriction : tracks >

PlateScanStore --> PlateScanApi : uses >
PlateScanStore --> IamStore : reads user >
PlateScanStore --> NutritionStore : logs meals via >
PlateScanStore --> DomainEventBus : publishes >
PlateScanStore ..> ScanResult : holds >
PlateScanStore ..> MealType : logs by >

@enduml
