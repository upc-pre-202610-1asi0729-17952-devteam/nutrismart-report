@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

title Nutrition Tracking — Infrastructure layer (nutrismart-webapp)

' ─── Boundary stubs: domain layer ────────────────────────────────────────────
package "nutrition-tracking/domain [boundary]" {
  class FoodItem <<entity>>
  class MealRecord <<entity>>
  class ScanResult <<entity>>
  class DailyIntake <<entity>>
}
package "shared/infrastructure [external]" {
  class BaseApi
  class BaseApiEndpoint
  interface BaseAssembler
  interface BaseResource
}

package "nutrition-tracking/infrastructure" {
  class NutritionApi <<@Injectable>>
  class PlateScanApi <<@Injectable>>

  class FoodSearchEndpoint <<endpoint>>
  class NutritionLogEndpoint <<endpoint>>
  class DailyBalanceEndpoint <<endpoint>>

  class FoodItemAssembler <<assembler>>
  class MealRecordAssembler <<assembler>>
  class ScanResultAssembler <<assembler>>
  class DailyIntakeAssembler <<assembler>>

  interface FoodItemResource <<resource>>
  interface MealRecordResource <<resource>>
  interface ScannedFoodItemResource <<resource>>
  interface ScanResultResource <<resource>>
  interface DailyIntakeResource <<resource>>
}

' ─── Relationships ────────────────────────────────────────────────────────────
NutritionApi --|> BaseApi
PlateScanApi --|> BaseApi
FoodSearchEndpoint --|> BaseApiEndpoint
NutritionLogEndpoint --|> BaseApiEndpoint
DailyBalanceEndpoint --|> BaseApiEndpoint
FoodItemAssembler ..|> BaseAssembler
MealRecordAssembler ..|> BaseAssembler
ScanResultAssembler ..|> BaseAssembler
DailyIntakeAssembler ..|> BaseAssembler
FoodItemResource --|> BaseResource
MealRecordResource --|> BaseResource
ScanResultResource --|> BaseResource
DailyIntakeResource --|> BaseResource

NutritionApi --> FoodSearchEndpoint : via >
NutritionApi --> NutritionLogEndpoint : via >
NutritionApi --> DailyBalanceEndpoint : via >
FoodSearchEndpoint --> FoodItemAssembler : maps via >
NutritionLogEndpoint --> MealRecordAssembler : maps via >
DailyBalanceEndpoint --> DailyIntakeAssembler : maps via >
PlateScanApi --> ScanResultAssembler : maps via >

FoodItemAssembler ..> FoodItem : builds >
FoodItemAssembler ..> FoodItemResource : reads/writes >
MealRecordAssembler ..> MealRecord : builds >
MealRecordAssembler ..> MealRecordResource : reads/writes >
ScanResultAssembler ..> ScanResult : builds >
ScanResultAssembler ..> ScanResultResource : reads/writes >
ScanResultResource "1" *--> "0..*" ScannedFoodItemResource : contains >
DailyIntakeAssembler ..> DailyIntake : builds >
DailyIntakeAssembler ..> DailyIntakeResource : reads/writes >

@enduml
