@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

package "nutrition-tracking/domain/model" {

  enum MealType {
    BREAKFAST
    LUNCH
    SNACK
    DINNER
  }

  enum GuardrailSeverity {
    BLOCK
    WARNING
    INFO
  }

  enum GuardrailType {
    CALORIE_OVERAGE
    RESTRICTION_CONFLICT
    MEDICAL_RISK
  }

  enum NutritionalRiskLevel {
    SAFE
    MODERATE
    HIGH
  }

  class MacronutrientDistribution <<value object>> {
    + calories: number
    + protein: number
    + carbs: number
    + fat: number
    + fiber: number
    + sugar: number
    --
    + add(other: MacronutrientDistribution): MacronutrientDistribution
    + scale(factor: number): MacronutrientDistribution
    + classifyRisk(): NutritionalRiskLevel
    + {static} zero(): MacronutrientDistribution
  }

  class MacroWarning <<value object>> {
    + macro: MacroName
    + level: WarningLevel
    + percent: number
    --
    + isApproaching: boolean
    + isExceeded: boolean
  }

  class PreLogGuardrail <<value object>> {
    + type: GuardrailType
    + severity: GuardrailSeverity
    + messageKey: string
    + recommendationKey: string
    + params: Record<string, unknown>
    --
    + isBlocking(): boolean
    + isInfo(): boolean
  }

  class DailyIntake <<entity>> {
    - _id: number
    - _userId: number
    - _date: string
    - _dailyGoal: number
    - _consumed: number
    - _active: number
    --
    + remaining: number
    + exceeded: boolean
    + percentConsumed: number
    + netCalories: number
    --
    + balanceSummary(): string
    + checkWarnings(): MacroWarning[]
    + evaluateCalorieOverage(): PreLogGuardrail | null
    + validateMacronutrients(dist: MacronutrientDistribution): PreLogGuardrail[]
  }

  class FoodItem <<entity>> {
    - _id: number
    - _name: string
    - _nameEs: string
    - _source: string
    - _servingSize: number
    - _servingUnit: string
    - _caloriesPer100g: number
    - _proteinPer100g: number
    - _carbsPer100g: number
    - _fatPer100g: number
    - _fiberPer100g: number
    - _sugarPer100g: number
    - _restrictions: DietaryRestriction[]
    --
    + getLocalizedName(locale: string): string
    + getNutrientsForQuantity(grams: number): MacronutrientDistribution
    + isRestrictedFor(restrictions: DietaryRestriction[]): boolean
    + conflictingRestrictions(userRestrictions: DietaryRestriction[]): DietaryRestriction[]
  }

  class MealRecord <<entity>> {
    - _id: number
    - _foodItemId: number
    - _foodItemName: string
    - _foodItemNameEs: string
    - _mealType: MealType
    - _quantity: number
    - _unit: string
    - _calories: number
    - _protein: number
    - _carbs: number
    - _fat: number
    - _fiber: number
    - _sugar: number
    - _loggedAt: string
    - _userId: number
    --
    + macroSummary: string
    + isFromToday: boolean
    + macros: MacronutrientDistribution
    --
    + getLocalizedFoodName(locale: string): string
    + classifyNutritionalRisk(): NutritionalRiskLevel
  }

  class ScanResult <<entity>> {
    - _id: number
    - _status: ScanStatus
    - _imageBase64: string
    - _detectedItems: ScannedFoodItem[]
    - _mealType: MealType
    - _source: string
    - _scannedAt: string
    --
    + totalCalories: number
    + hasItems: boolean
    --
    + updateItemQuantity(id: number, qty: number): void
    + removeItem(id: number): void
    + markAsSuccess(): void
    + markAsInvalid(): void
  }
}

package "nutrition-tracking/domain/events" {

  class DailyTargetsSet <<domain event>> {
    + eventType: string
    + userId: number
    + dailyCalories: number
    + proteinTarget: number
    + carbsTarget: number
    + fatTarget: number
  }

  class DietaryRestrictionsRegistered <<domain event>> {
    + eventType: string
    + userId: number
    + restrictions: string[]
  }

  class FoodSearchExecuted <<domain event>> {
    + eventType: string
    + userId: number
    + query: string
    + resultsCount: number
  }

  class MealPhotoAnalyzed <<domain event>> {
    + eventType: string
    + userId: number
    + itemsDetected: number
    + estimatedCalories: number
  }

  class NetTargetUpdated <<domain event>> {
    + eventType: string
    + userId: number
    + newNetTarget: number
  }
}

DailyIntake ..> MacroWarning : produces >
DailyIntake ..> PreLogGuardrail : evaluates >
MealRecord "1" *--> "1" MealType : typed as >
MealRecord ..> MacronutrientDistribution : exposes macros >
MealRecord ..> NutritionalRiskLevel : classifies >
FoodItem "1" *--> "0..*" DietaryRestriction : restricts >
FoodItem ..> MacronutrientDistribution : produces nutrients >
PreLogGuardrail "1" *--> "1" GuardrailType : typed as >
PreLogGuardrail "1" *--> "1" GuardrailSeverity : severity >
ScanResult "1" *--> "1" MealType : scanned as >
MacroWarning ..> NutritionalRiskLevel : level context >

@enduml
