@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

title Nutrition Tracking — Presentation layer (nutrismart-webapp)

' ─── Boundary stubs: application layer ───────────────────────────────────────
package "nutrition-tracking/application [boundary]" {
  class NutritionStore <<store>>
}
package "iam/application [boundary]" {
  class IamStore <<store>>
}

package "nutrition-tracking/presentation/views" {
  class DailyLog <<@Component view>> {
    - iamStore: IamStore
    # nutritionStore: NutritionStore
  }
  class NutritionLogShell <<@Component view>>
}

package "nutrition-tracking/presentation/components" {
  class AddFoodDialogComponent <<@Component>>
  class DailyBalancePanelComponent <<@Component>>
  class FoodSearchPanelComponent <<@Component>> {
    # nutritionStore: NutritionStore
    - iamStore: IamStore
  }
  class MealEntryDetailComponent <<@Component>>
  class MealSectionComponent <<@Component>>
  class RestrictedItemDialogComponent <<@Component>> {
    - iamStore: IamStore
  }
}

package "nutrition-tracking/presentation [routes]" {
  class NutritionRoutes <<routes>>
  class NutritionLogRoutes <<routes>>
}

' ─── Relationships ────────────────────────────────────────────────────────────
DailyLog --> NutritionStore : uses >
DailyLog --> IamStore : uses >
FoodSearchPanelComponent --> NutritionStore : uses >
FoodSearchPanelComponent --> IamStore : uses >
RestrictedItemDialogComponent --> IamStore : uses >

DailyLog *--> AddFoodDialogComponent : composes >
DailyLog *--> DailyBalancePanelComponent : composes >
DailyLog *--> FoodSearchPanelComponent : composes >
DailyLog *--> MealEntryDetailComponent : composes >
DailyLog *--> MealSectionComponent : composes >
DailyLog *--> RestrictedItemDialogComponent : composes >
NutritionLogShell *--> DailyLog : hosts >

NutritionRoutes ..> DailyLog : routes to >
NutritionLogRoutes ..> NutritionLogShell : routes to >

@enduml
