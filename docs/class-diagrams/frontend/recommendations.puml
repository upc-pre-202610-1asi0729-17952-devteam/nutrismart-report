@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "recommendations/domain/model" {
  class RecommendationSet {
    + id: string
    + generatedAt: string
    + expiresAt: string
    + items: Recommendation[]
    + isExpired(): boolean
    + getByType(type: RecommendationType): Recommendation[]
  }
  class Recommendation {
    + id: string
    + type: RecommendationType
    + title: string
    + description: string
    + priority: number
  }
  enum RecommendationType {
    FOOD_SUGGESTION
    HYDRATION_REMINDER
    MEAL_TIMING
    MACRO_BALANCE
    WEATHER_BASED
  }
}

package "recommendations/application/services" {
  class RecommendationService {
    - api: RecommendationApiService
    - geolocation: GeolocationService
    + currentSet: WritableSignal<RecommendationSet | null>
    + isLoading: WritableSignal<boolean>
    + generate(userId: string, caloriesConsumed: number, calorieTarget: number): Observable<RecommendationSet>
    + getLatest(userId: string): Observable<RecommendationSet>
    + refreshIfExpired(userId: string, caloriesConsumed: number, target: number): void
  }
  class GeolocationService {
    + currentCoords: WritableSignal<GeolocationCoordinates | null>
    + hasPermission: WritableSignal<boolean>
    + requestPosition(): Promise<GeolocationCoordinates>
  }
}

package "recommendations/infrastructure/http" {
  class RecommendationApiService {
    - http: HttpClient
    + postGenerate(userId: string, body: GenerateRequest): Observable<RecommendationSet>
    + getLatest(userId: string): Observable<RecommendationSet>
  }
  class GenerateRequest {
    + latitude: number
    + longitude: number
  }
}

package "recommendations/presentation/components" {
  class "«Component»\nRecommendationPanelComponent" as RecommendationPanelComponent {
    - recService: RecommendationService
    + currentSet: Signal<RecommendationSet | null>
    + isLoading: Signal<boolean>
    + groupedRecs: Signal<Record<string, Recommendation[]>>
    + onRefresh(): void
  }
  class "«Component»\nRecommendationCardComponent" as RecommendationCardComponent {
    + recommendation: InputSignal<Recommendation>
    + icon: Signal<string>
    + chipColor: Signal<string>
  }
  class "«Component»\nContextBannerComponent" as ContextBannerComponent {
    - geoService: GeolocationService
    + coords: Signal<GeolocationCoordinates | null>
    + locationLabel: WritableSignal<string>
    + weatherSummary: WritableSignal<string>
    + onEnableLocation(): void
  }
}

RecommendationService --> RecommendationApiService : uses >
RecommendationService --> GeolocationService : uses >
RecommendationService --> "1" RecommendationSet : holds >
RecommendationSet "1" *--> "1..*" Recommendation : contains >
Recommendation "1" *--> "1" RecommendationType : typed as >

RecommendationPanelComponent --> RecommendationService : uses >
RecommendationPanelComponent o--> "0..*" RecommendationCardComponent : renders >
RecommendationCardComponent ..> Recommendation : reads >
ContextBannerComponent --> GeolocationService : uses >

@enduml