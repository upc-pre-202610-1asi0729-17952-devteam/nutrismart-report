@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

title Restaurant Intelligence — Application layer (nutrismart-webapp)

' ─── Boundary stubs: domain & infrastructure ─────────────────────────────────
package "restaurant-intelligence/domain [boundary]" {
  class MenuAnalysis <<entity>>
}
package "restaurant-intelligence/infrastructure [boundary]" {
  class RestaurantMenuApi <<api>>
}
package "<<other contexts>> [external]" {
  class IamStore <<iam>>
  class NutritionStore <<nutrition-tracking>>
  class TranslateStore <<shared>>
  class DomainEventBus <<shared>>
}

package "restaurant-intelligence/application" {
  class RestaurantMenuStore <<@Injectable store>> {
    - restaurantMenuApi: RestaurantMenuApi
    - iamStore: IamStore
    - nutritionStore: NutritionStore
    - translateStore: TranslateStore
    - domainEventBus: DomainEventBus
    --
    + menuView: Signal<MenuView>
    + loading: Signal<boolean>
    + error: Signal<string | null>
    - _rawMenuAnalysis: Signal<MenuAnalysis | null>
  }
}

' ─── Relationships ────────────────────────────────────────────────────────────
RestaurantMenuStore --> RestaurantMenuApi : uses >
RestaurantMenuStore --> IamStore : reads user/restrictions >
RestaurantMenuStore --> NutritionStore : reads remaining macros >
RestaurantMenuStore --> TranslateStore : localizes via >
RestaurantMenuStore --> DomainEventBus : publishes >
RestaurantMenuStore ..> MenuAnalysis : holds >

@enduml
