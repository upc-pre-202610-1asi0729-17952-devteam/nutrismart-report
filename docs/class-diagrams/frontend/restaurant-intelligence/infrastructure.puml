@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

title Restaurant Intelligence — Infrastructure layer (nutrismart-webapp)

' ─── Boundary stubs: domain layer ────────────────────────────────────────────
package "restaurant-intelligence/domain [boundary]" {
  class MenuAnalysis <<entity>>
}
package "shared/infrastructure [external]" {
  class BaseApi
  interface BaseAssembler
  interface BaseResource
  interface BaseResponse
}

package "restaurant-intelligence/infrastructure" {
  class RestaurantMenuApi <<@Injectable>> {
    - _http: HttpClient
    - _translate: TranslateService
    + scanMenuPhoto(imageBase64): Observable<RawMenuScan>
    + rankMenuDishes(menuAnalysisId, userRestrictions): Observable<RawMenuScan>
  }
  class MenuAnalysisAssembler <<assembler>> {
    + toEntityFromResource(r: MenuAnalysisResource): MenuAnalysis
    + toResourceFromEntity(e: MenuAnalysis): MenuAnalysisResource
    + toEntitiesFromResponse(response: MenuAnalysisResponse): MenuAnalysis[]
  }
  interface RawMenuDish <<dto>>
  interface RawMenuScan <<dto>>
  interface MenuAnalysisResource <<resource>>
  interface MenuAnalysisResponse <<response>>
  interface RankedDishResource <<resource>>
  interface RestrictedDishResource <<resource>>
}

' ─── Relationships ────────────────────────────────────────────────────────────
RestaurantMenuApi --|> BaseApi
MenuAnalysisAssembler ..|> BaseAssembler
MenuAnalysisResource --|> BaseResource
MenuAnalysisResponse --|> BaseResponse

RestaurantMenuApi ..> RawMenuScan : returns >
RawMenuScan "1" *--> "0..*" RawMenuDish : contains >
MenuAnalysisAssembler ..> MenuAnalysis : builds >
MenuAnalysisAssembler ..> MenuAnalysisResource : reads/writes >
MenuAnalysisResource "1" *--> "0..*" RankedDishResource : contains >
MenuAnalysisResource "1" *--> "0..*" RestrictedDishResource : contains >

@enduml
