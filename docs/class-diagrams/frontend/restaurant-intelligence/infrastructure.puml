@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

' ─── Boundary stubs: shared/infrastructure ───────────────────────────────────
package "shared/infrastructure [boundary]" {
  abstract class BaseApi <<boundary>> {
  }
  interface BaseAssembler <<boundary>> {
  }
  abstract class BaseApiEndpoint <<boundary>> {
  }
}

' ─── Boundary stubs: restaurant-intelligence/domain ──────────────────────────
package "restaurant-intelligence/domain [boundary]" {
  class MenuAnalysis <<boundary>> {
    + id: number
    + userId: number
  }
}

' ─── Resources ───────────────────────────────────────────────────────────────
package "restaurant-intelligence/infrastructure/resources" {

  class AnalyzedDishResource <<resource>> {
    + name: string
    + nameKey: string
    + calories: number
    + protein: number
    + carbs: number
    + fat: number
    + goalScore: number
    + restrictionConflicts: string[]
    + isRecommended: boolean
  }

  class MenuAnalysisResource <<resource>> {
    + id: number
    + userId: number
    + restaurantName: string
    + menuImageBase64: string
    + analyzedAt: string
    + dishes: AnalyzedDishResource[]
    + status: string
  }

  class MenuAnalysisResponse <<resource>> {
    + menuAnalyses: MenuAnalysisResource[]
  }
}

' ─── Assemblers ──────────────────────────────────────────────────────────────
package "restaurant-intelligence/infrastructure/assemblers" {

  class RestaurantMenuAssembler <<assembler>> {
    + toEntityFromResource(resource: MenuAnalysisResource): MenuAnalysis
    + toResourceFromEntity(entity: MenuAnalysis): MenuAnalysisResource
    + toEntitiesFromResponse(response: MenuAnalysisResponse): MenuAnalysis[]
  }
}

' ─── HTTP ────────────────────────────────────────────────────────────────────
package "restaurant-intelligence/infrastructure/http" {

  class RestaurantMenuApiEndpoint <<endpoint>> {
    - assembler: RestaurantMenuAssembler
    --
    + getAll(): Observable<MenuAnalysis[]>
    + getById(id: number): Observable<MenuAnalysis>
    + create(entity: MenuAnalysis): Observable<MenuAnalysis>
  }

  class RestaurantMenuApi <<api>> {
    - endpoint: RestaurantMenuApiEndpoint
    --
    + analyzeMenu(userId: number, imageBase64: string, restaurantName: string): Observable<MenuAnalysis>
    + getAnalysisHistory(userId: number): Observable<MenuAnalysis[]>
  }
}

RestaurantMenuApi --|> BaseApi : extends >
RestaurantMenuApiEndpoint --|> BaseApiEndpoint : extends >
RestaurantMenuAssembler ..|> BaseAssembler : implements >

MenuAnalysisResponse "1" *--> "0..*" MenuAnalysisResource : contains >
MenuAnalysisResource "1" *--> "0..*" AnalyzedDishResource : contains >

RestaurantMenuAssembler --> MenuAnalysisResource : reads >
RestaurantMenuAssembler --> MenuAnalysisResponse : reads >
RestaurantMenuAssembler ..> MenuAnalysis : produces >

RestaurantMenuApiEndpoint --> RestaurantMenuAssembler : uses >
RestaurantMenuApi o--> RestaurantMenuApiEndpoint : delegates to >

@enduml
