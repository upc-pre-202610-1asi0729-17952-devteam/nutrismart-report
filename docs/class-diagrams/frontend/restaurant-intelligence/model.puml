@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

package "restaurant-intelligence/domain/model" {

  class MenuAnalysis <<entity>> {
    - _id: number
    - _userId: number
    - _restaurantName: string
    - _menuImageBase64: string
    - _analyzedAt: string
    - _dishes: AnalyzedDish[]
    - _status: string
    --
    + bestDishes: AnalyzedDish[]
    + totalDishesAnalyzed: number
    --
    + getGoalAlignedDishes(goal: string): AnalyzedDish[]
    + getDishesCompatibleWith(restrictions: string[]): AnalyzedDish[]
    + hasDishConflict(restrictions: string[]): boolean
  }

  class AnalyzedDish <<value object>> {
    + name: string
    + nameKey: string
    + calories: number
    + protein: number
    + carbs: number
    + fat: number
    + goalScore: number
    + restrictionConflicts: string[]
    + macroSummary: string
    + isRecommended: boolean
  }
}

package "restaurant-intelligence/domain/events" {

  class RestaurantMealAnalyzed <<domain event>> {
    + eventType: string
    + userId: number
    + restaurantName: string
    + dishesDetected: number
    + estimatedCalories: number
    + analyzedAt: string
  }
}

MenuAnalysis "1" *--> "0..*" AnalyzedDish : contains >
RestaurantMealAnalyzed ..> MenuAnalysis : produced by >

@enduml
