@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

title Restaurant Intelligence — Presentation layer (nutrismart-webapp)

' ─── Boundary stubs: application layer ───────────────────────────────────────
package "restaurant-intelligence/application [boundary]" {
  class RestaurantMenuStore <<store>>
}
package "<<other contexts>> [boundary]" {
  class IamStore <<iam>>
  class PlateScanStore <<nutrition-tracking>>
}

package "restaurant-intelligence/presentation/views" {
  class RestaurantMenu <<@Component view>> {
    # iamStore: IamStore
    # plateScanStore: PlateScanStore
    # restaurantMenuStore: RestaurantMenuStore
    - router: Router
    - _translate: TranslateService
  }
}

package "restaurant-intelligence/presentation [routes]" {
  class RestaurantMenuRoutes <<routes>>
}

' ─── Relationships ────────────────────────────────────────────────────────────
RestaurantMenu --> RestaurantMenuStore : uses >
RestaurantMenu --> IamStore : uses >
RestaurantMenu --> PlateScanStore : uses >
RestaurantMenuRoutes ..> RestaurantMenu : routes to >

@enduml
