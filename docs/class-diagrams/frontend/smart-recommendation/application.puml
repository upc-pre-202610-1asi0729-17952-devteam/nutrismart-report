@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

title Smart Recommendation — Application layer (nutrismart-webapp)

' ─── Boundary stubs: domain & infrastructure ─────────────────────────────────
package "smart-recommendation/domain [boundary]" {
  class PantryItem <<entity>>
  class RecipeSuggestion <<entity>>
  class RecommendationSession <<entity>>
}
package "smart-recommendation/infrastructure [boundary]" {
  class PantryApi <<api>>
  class RecommendationsApi <<api>>
}
package "<<other contexts / shared>> [external]" {
  class IamStore <<iam>>
  class NutritionStore <<nutrition-tracking>>
  class BehavioralConsistencyStore <<behavioral-consistency>>
  class DomainEventBus <<shared>>
  class NotificationService <<shared>>
  class GeolocationService <<shared>>
  class GeocodingService <<shared>>
}

package "smart-recommendation/application" {
  class PantryStore <<@Injectable store>> {
    - pantryApi: PantryApi
    - iamStore: IamStore
    - nutritionStore: NutritionStore
    - eventBus: DomainEventBus
    --
    + dailyConsumed: Signal<number>
    + dailyGoal: Signal<number>
    + remainingCalories: Signal<number>
    + remainingProtein: Signal<number>
    + userGoal: Signal<...>
    + fetchCatalog(): void
  }
  class RecommendationsStore <<@Injectable store>> {
    - api: RecommendationsApi
    - iamStore: IamStore
    - bcStore: BehavioralConsistencyStore
    - eventBus: DomainEventBus
    - notificationService: NotificationService
    - geolocation: GeolocationService
    - geocoding: GeocodingService
    --
    + showPreventiveCard: Signal<boolean>
    + showInterventionCard: Signal<boolean>
    + activeCards: Signal<...>
  }
}

' ─── Relationships ────────────────────────────────────────────────────────────
PantryStore --> PantryApi : uses >
PantryStore --> IamStore : reads user >
PantryStore --> NutritionStore : reads intake >
PantryStore --> DomainEventBus : publishes >
PantryStore ..> PantryItem : holds >
PantryStore ..> RecipeSuggestion : suggests >

RecommendationsStore --> RecommendationsApi : uses >
RecommendationsStore --> IamStore : reads user >
RecommendationsStore --> BehavioralConsistencyStore : reads adherence >
RecommendationsStore --> DomainEventBus : subscribes/publishes >
RecommendationsStore --> NotificationService : notifies via >
RecommendationsStore --> GeolocationService : locates via >
RecommendationsStore --> GeocodingService : geocodes via >
RecommendationsStore ..> RecommendationSession : holds >

@enduml
