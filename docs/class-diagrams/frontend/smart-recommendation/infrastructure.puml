@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

title Smart Recommendation — Infrastructure layer (nutrismart-webapp)

' ─── Boundary stubs: domain layer ────────────────────────────────────────────
package "smart-recommendation/domain [boundary]" {
  class PantryItem <<entity>>
  class RecipeSuggestion <<entity>>
  class WeatherContext <<entity>>
  class TravelContext <<entity>>
  class LocationSnapshot <<entity>>
}
package "shared/infrastructure [external]" {
  class BaseApi
  interface BaseAssembler
  interface BaseResource
}

package "smart-recommendation/infrastructure" {
  class PantryApi <<@Injectable>>
  class RecommendationsApi <<@Injectable>>

  class PantryItemAssembler <<assembler>>
  class RecipeSuggestionAssembler <<assembler>>
  class LocationSnapshotAssembler <<assembler>>
  class WeatherContextAssembler <<assembler>>
  class TravelContextAssembler <<assembler>>

  interface PantryItemResource <<resource>>
  interface RecipeSuggestionResource <<resource>>
  interface LocationSnapshotResource <<resource>>
  interface WeatherContextResource <<resource>>
  interface TravelContextResource <<resource>>
  interface RecommendationSessionResource <<resource>>
  interface RecommendationCard <<dto>>
}

' ─── Relationships ────────────────────────────────────────────────────────────
PantryApi --|> BaseApi
RecommendationsApi --|> BaseApi
PantryItemAssembler ..|> BaseAssembler
RecipeSuggestionAssembler ..|> BaseAssembler
WeatherContextAssembler ..|> BaseAssembler
TravelContextAssembler ..|> BaseAssembler
PantryItemResource --|> BaseResource
RecipeSuggestionResource --|> BaseResource

PantryApi --> PantryItemAssembler : maps via >
PantryApi --> RecipeSuggestionAssembler : maps via >
RecommendationsApi --> LocationSnapshotAssembler : maps via >
RecommendationsApi --> WeatherContextAssembler : maps via >
RecommendationsApi --> TravelContextAssembler : maps via >
RecommendationsApi ..> RecommendationCard : returns >

PantryItemAssembler ..> PantryItem : builds >
PantryItemAssembler ..> PantryItemResource : reads/writes >
RecipeSuggestionAssembler ..> RecipeSuggestion : builds >
RecipeSuggestionAssembler ..> RecipeSuggestionResource : reads/writes >
LocationSnapshotAssembler ..> LocationSnapshot : builds >
LocationSnapshotAssembler ..> LocationSnapshotResource : reads/writes >
RecommendationsApi ..> RecommendationSessionResource : transports >
WeatherContextAssembler ..> WeatherContext : builds >
WeatherContextAssembler ..> WeatherContextResource : reads/writes >
TravelContextAssembler ..> TravelContext : builds >
TravelContextAssembler ..> TravelContextResource : reads/writes >

@enduml
