@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

package "smart-recommendation/domain/model" {

  enum AdherenceStatus {
    ON_TRACK
    AT_RISK
    DROPPED
  }

  enum WeatherType {
    SUNNY
    CLOUDY
    RAINY
    SNOWY
    HOT
    COLD
  }

  class ContextualTargetAdjustment <<value object>> {
    + calorieAdjustment: number
    + proteinBoost: number
    + reason: string
    + appliedAt: string
  }

  class IngredientCatalogItem <<entity>> {
    - _id: number
    - _name: string
    - _nameKey: string
    - _category: string
    - _caloriesPer100g: number
    - _proteinPer100g: number
    - _carbsPer100g: number
    - _fatPer100g: number
  }

  class PantryItem <<entity>> {
    - _id: number
    - _name: string
    - _nameKey: string
    - _category: string
    - _quantityGrams: number
    - _caloriesPer100g: number
    - _userId: number
    - _addedAt: string
    --
    + totalCalories: number
    --
    + isSameIngredient(other: PantryItem): boolean
    + addQuantity(grams: number): void
  }

  class RecipeSuggestion <<entity>> {
    - _id: number
    - _name: string
    - _nameKey: string
    - _calories: number
    - _protein: number
    - _carbs: number
    - _fat: number
    - _ingredients: string[]
    - _goalType: string
    - _prepTimeMinutes: number
    - _coversMacroPct: number
    - _restrictionsConflict: boolean
    --
    + goalBadgeLabel: string
    + goalBadgeColor: string
    + macroSummary: string
    + ingredientList: string
    --
    + isGoalAligned(userGoal: string): boolean
    + isCompatibleWith(restrictions: string[]): boolean
    + hasConflictWith(restrictions: string[]): boolean
  }

  class LocationSnapshot <<entity>> {
    - _id: number
    - _userId: number
    - _city: string
    - _country: string
    - _latitude: number
    - _longitude: number
    - _capturedAt: string
  }

  class WeatherContext <<entity>> {
    - _id: number
    - _userId: number
    - _temperature: number
    - _weatherType: WeatherType
    - _city: string
    - _capturedAt: string
  }

  class TravelContext <<entity>> {
    - _id: number
    - _userId: number
    - _originCity: string
    - _destinationCity: string
    - _isActive: boolean
    - _startedAt: string
  }

  class RecommendationSession <<entity>> {
    - _id: number
    - _userId: number
    - _adherenceStatus: AdherenceStatus
    - _consecutiveMisses: number
    - _simplifiedKcalTarget: number
    - _createdAt: string
    - _isActive: boolean
    --
    + adjustedKcalTarget: number
    --
    + requiresPreventiveRecommendation(): boolean
    + requiresInterventionRecommendation(): boolean
    + usesWeatherRecommendations(): boolean
    + preventiveEventLabel(): string
    + interventionEventLabel(): string
    + applyContextualAdjustment(adj: ContextualTargetAdjustment): void
  }
}

RecommendationSession "1" *--> "1" AdherenceStatus : has status >
RecommendationSession ..> ContextualTargetAdjustment : adjusted by >
WeatherContext "1" *--> "1" WeatherType : has type >

@enduml
