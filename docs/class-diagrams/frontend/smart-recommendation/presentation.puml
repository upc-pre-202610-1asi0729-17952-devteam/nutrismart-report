@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

title Smart Recommendation — Presentation layer (nutrismart-webapp)

' ─── Boundary stubs: application layer ───────────────────────────────────────
package "smart-recommendation/application [boundary]" {
  class PantryStore <<store>>
  class RecommendationsStore <<store>>
}
package "<<other contexts / shared>> [boundary]" {
  class IamStore <<iam>>
  class NutritionStore <<nutrition-tracking>>
  class GeocodingService <<shared>>
}

package "smart-recommendation/presentation/views" {
  class RecommendationsHub <<@Component view>>
  class RecommendationsView <<@Component view>> {
    # store: RecommendationsStore
    # iamStore: IamStore
    # nutStore: NutritionStore
  }
  class Pantry <<@Component view>> {
    # iamStore: IamStore
    # pantryStore: PantryStore
    - nutritionStore: NutritionStore
  }
  class LocationSearchView <<@Component view>> {
    # store: RecommendationsStore
    - geocoding: GeocodingService
  }
}

package "smart-recommendation/presentation/components" {
  class AddRecommendationDialogComponent <<@Component>>
  class LocationPicker <<@Component>> {
    - geocoding: GeocodingService
  }
}

package "smart-recommendation/presentation [routes]" {
  class PantryRoutes <<routes>>
  class RecommendationsRoutes <<routes>>
  class RecommendationsHubRoutes <<routes>>
}

' ─── Relationships ────────────────────────────────────────────────────────────
RecommendationsView --> RecommendationsStore : uses >
RecommendationsView --> IamStore : uses >
RecommendationsView --> NutritionStore : uses >
Pantry --> PantryStore : uses >
Pantry --> IamStore : uses >
Pantry --> NutritionStore : uses >
LocationSearchView --> RecommendationsStore : uses >
LocationSearchView --> GeocodingService : uses >
LocationPicker --> GeocodingService : uses >

RecommendationsView *--> AddRecommendationDialogComponent : composes >
LocationSearchView *--> LocationPicker : composes >

RecommendationsHubRoutes ..> RecommendationsHub : routes to >
RecommendationsRoutes ..> RecommendationsView : routes to >
RecommendationsRoutes ..> LocationSearchView : routes to >
PantryRoutes ..> Pantry : routes to >

@enduml
