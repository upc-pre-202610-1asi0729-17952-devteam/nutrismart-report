@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

title Subscriptions — Application layer (nutrismart-webapp)

' ─── Boundary stubs: domain & infrastructure ─────────────────────────────────
package "subscriptions/domain [boundary]" {
  class Subscription <<entity>>
  class BillingRecord <<entity>>
  class PaymentMethod <<value object>>
  abstract class PaymentGatewayPort <<port>>
}
package "subscriptions/infrastructure [boundary]" {
  class SubscriptionApi <<api>>
  class BillingHistoryApi <<api>>
}
package "<<other contexts>> [external]" {
  class IamStore <<iam>>
  class DomainEventBus <<shared>>
}

package "subscriptions/application" {
  class SubscriptionsStore <<@Injectable store>> {
    - api: SubscriptionApi
    - billingHistoryApi: BillingHistoryApi
    - iamStore: IamStore
    - eventBus: DomainEventBus
    --
    + subscription: Signal<Subscription | null>
    + billingHistory: Signal<BillingRecord[]>
    + activeFeatures: Signal<string[]>
    + loading: Signal<boolean>
    + initialise(userId): Promise<void>
    + loadBillingHistory(userId): Promise<void>
    + selectPlan(plan): Promise<void>
    + cancelSubscription(): Promise<void>
    + hasActivePlan(): boolean
  }
  class PaymentStore <<@Injectable store>> {
    - gateway: PaymentGatewayPort
    - subscriptionsStore: SubscriptionsStore
    - eventBus: DomainEventBus
    - iamStore: IamStore
    --
    + selectedPlan: Signal<SubscriptionPlan | null>
    + paymentMethod: Signal<PaymentMethod | null>
    + processing: Signal<boolean>
    + confirmed: Signal<boolean>
    + error: Signal<string | null>
  }
}

' ─── Relationships ────────────────────────────────────────────────────────────
SubscriptionsStore --> SubscriptionApi : uses >
SubscriptionsStore --> BillingHistoryApi : uses >
SubscriptionsStore --> IamStore : reads user >
SubscriptionsStore --> DomainEventBus : publishes >
SubscriptionsStore ..> Subscription : holds >
SubscriptionsStore ..> BillingRecord : holds >

PaymentStore --> PaymentGatewayPort : charges via >
PaymentStore --> SubscriptionsStore : activates plan via >
PaymentStore --> IamStore : reads user >
PaymentStore --> DomainEventBus : subscribes/publishes >
PaymentStore ..> PaymentMethod : holds >

@enduml
