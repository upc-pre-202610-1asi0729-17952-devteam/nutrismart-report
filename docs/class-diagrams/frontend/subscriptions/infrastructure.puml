@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

title Subscriptions — Infrastructure layer (nutrismart-webapp)

' ─── Boundary stubs: domain layer ────────────────────────────────────────────
package "subscriptions/domain [boundary]" {
  class Subscription <<entity>>
  class BillingRecord <<entity>>
  class PaymentIntent <<entity>>
  class PaymentMethod <<value object>>
  abstract class PaymentGatewayPort <<port>>
  interface PaymentResult <<dto>>
}

package "subscriptions/infrastructure" {
  class SubscriptionApi <<@Injectable>> {
    + getSubscription(userId): Observable<Subscription | null>
    + createSubscription(subscription): Observable<Subscription>
    + updateSubscription(subscription): Observable<Subscription>
  }
  class BillingHistoryApi <<@Injectable>> {
    + getHistory(userId): Observable<BillingRecord[]>
    + createRecord(data: NewBillingRecord): Observable<BillingRecord>
  }
  class SubscriptionAssembler <<assembler>> {
    + toEntityFromResource(r: SubscriptionResource): Subscription
    + toResourceFromEntity(e: Subscription): SubscriptionResource
  }
  class BillingHistoryAssembler <<assembler>> {
    + toEntityFromResource(r: BillingHistoryResource): BillingRecord
  }
  class SimulatedPaymentGateway <<@Injectable>> {
    + processPayment(intent: PaymentIntent, method: PaymentMethod): Observable<PaymentResult>
  }
  class StripePaymentGateway <<@Injectable>> {
    + processPayment(intent: PaymentIntent, method: PaymentMethod): Observable<PaymentResult>
  }
  class PaymentMethodApi <<@Injectable>> {
    + register(resource: RegisterPaymentMethodResource): Observable<PaymentMethod>
    + getByUser(userId: number): Observable<PaymentMethod[]>
    + delete(id: number): Observable<void>
  }
  interface SubscriptionResource <<resource>>
  interface BillingHistoryResource <<resource>>
  interface PaymentMethodResource <<resource>>
  interface RegisterPaymentMethodResource <<resource>>
  interface NewBillingRecord <<dto>>
}

' ─── Relationships ────────────────────────────────────────────────────────────
SimulatedPaymentGateway --|> PaymentGatewayPort
SubscriptionApi --> SubscriptionAssembler : maps via >
BillingHistoryApi --> BillingHistoryAssembler : maps via >
SubscriptionApi ..> Subscription : returns >
BillingHistoryApi ..> BillingRecord : returns >
SubscriptionAssembler ..> Subscription : builds >
SubscriptionAssembler ..> SubscriptionResource : reads/writes >
BillingHistoryAssembler ..> BillingRecord : builds >
BillingHistoryAssembler ..> BillingHistoryResource : reads >
SimulatedPaymentGateway ..> PaymentIntent : charges >
SimulatedPaymentGateway ..> PaymentMethod : with method >
BillingHistoryApi ..> NewBillingRecord : accepts >
SimulatedPaymentGateway ..> PaymentResult : returns >

StripePaymentGateway --|> PaymentGatewayPort
StripePaymentGateway ..> PaymentIntent : charges >
StripePaymentGateway ..> PaymentMethod : with method >
StripePaymentGateway ..> PaymentResult : returns >
PaymentMethodApi ..> PaymentMethod : returns >
PaymentMethodApi ..> PaymentMethodResource : reads >
PaymentMethodApi ..> RegisterPaymentMethodResource : accepts >

@enduml
