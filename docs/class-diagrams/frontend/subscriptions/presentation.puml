@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

title Subscriptions — Presentation layer (nutrismart-webapp)

' ─── Boundary stubs: application layer ───────────────────────────────────────
package "subscriptions/application [boundary]" {
  class SubscriptionsStore <<store>>
  class PaymentStore <<store>>
}
package "iam/application [boundary]" {
  class IamStore <<store>>
}

package "subscriptions/presentation/views" {
  class SubscriptionPlans <<@Component view>> {
    # store: SubscriptionsStore
    - payStore: PaymentStore
    - iamStore: IamStore
  }
  class PaymentGateway <<@Component view>> {
    - store: PaymentStore
    - fb: FormBuilder
  }
  class CheckoutSummary <<@Component view>> {
    # store: PaymentStore
    - iamStore: IamStore
  }
  class SubscriptionConfirmed <<@Component view>> {
    - store: PaymentStore
  }
  class BillingPanel <<@Component view>> {
    # store: SubscriptionsStore
    - payStore: PaymentStore
    - iamStore: IamStore
  }
  class UpgradeGate <<@Component view>> {
    - iamStore: IamStore
    - paymentStore: PaymentStore
  }
}

package "subscriptions/presentation [routes]" {
  class SubscriptionsRoutes <<routes>>
}

' ─── Relationships ────────────────────────────────────────────────────────────
SubscriptionPlans --> SubscriptionsStore : uses >
SubscriptionPlans --> PaymentStore : uses >
SubscriptionPlans --> IamStore : uses >
PaymentGateway --> PaymentStore : uses >
CheckoutSummary --> PaymentStore : uses >
CheckoutSummary --> IamStore : uses >
SubscriptionConfirmed --> PaymentStore : uses >
BillingPanel --> SubscriptionsStore : uses >
BillingPanel --> PaymentStore : uses >
BillingPanel --> IamStore : uses >
UpgradeGate --> PaymentStore : uses >
UpgradeGate --> IamStore : uses >

SubscriptionsRoutes ..> SubscriptionPlans : routes to >
SubscriptionsRoutes ..> PaymentGateway : routes to >
SubscriptionsRoutes ..> CheckoutSummary : routes to >
SubscriptionsRoutes ..> SubscriptionConfirmed : routes to >
SubscriptionsRoutes ..> BillingPanel : routes to >
SubscriptionsRoutes ..> UpgradeGate : routes to >

@enduml
