@startuml
skinparam monochrome false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

' ─── Boundary stub: application layer ────────────────────────────────────────
package "subscriptions/application [boundary]" {
  class SubscriptionsStore <<boundary>> {
    + currentSubscription: Signal<Subscription | null>
    + loading: Signal<boolean>
    + error: Signal<string | null>
    + isActive: Signal<boolean>
    + isPro: Signal<boolean>
    + isPremium: Signal<boolean>
    + features: Signal<PlanFeatures>
    + daysUntilExpiry: Signal<number | null>
    + upgradeToPlan(plan: SubscriptionPlan): Promise<void>
    + cancelSubscription(): Promise<void>
    + canAccess(feature): boolean
  }
}

package "iam/application [boundary]" {
  class IamStore <<boundary>> {
    + currentUser: Signal<User | null>
  }
}

' ─── ViewModels ──────────────────────────────────────────────────────────────
package "subscriptions/presentation/viewmodels" {

  class PlanCardVm <<view model>> {
    + planKey: string
    + priceLabel: string
    + billingKey: string
    + featuresKeys: string[]
    + isCurrentPlan: boolean
    + isRecommended: boolean
    + ctaKey: string
    + disabled: boolean
  }

  class FeatureRowVm <<view model>> {
    + featureKey: string
    + basicEnabled: boolean
    + proEnabled: boolean
    + premiumEnabled: boolean
    + highlightPlan: string
  }

  class SubscriptionStatusVm <<view model>> {
    + planKey: string
    + statusKey: string
    + expiryLabel: string | null
    + daysUntilExpiry: number | null
    + isPro: boolean
    + isPremium: boolean
    + canCancel: boolean
  }

  class SubscriptionPlansVm <<view model>> {
    + plans: PlanCardVm[]
    + featureRows: FeatureRowVm[]
    + currentStatusVm: SubscriptionStatusVm
    + isLoading: boolean
    + errorKey: string | null
  }
}

' ─── Views ───────────────────────────────────────────────────────────────────
package "subscriptions/presentation/views" {

  class SubscriptionPlansView <<view>> {
    - subscriptionsStore: SubscriptionsStore
    - iamStore: IamStore
    --
    + plansVm: Signal<SubscriptionPlansVm>
    + isLoading: Signal<boolean>
    --
    + onSelectPlan(planKey: string): void
    + onCancel(): void
  }
}

' ─── Relationships ────────────────────────────────────────────────────────────
SubscriptionPlansView o--> SubscriptionsStore : uses >
SubscriptionPlansView o--> IamStore : uses >
SubscriptionPlansView ..> SubscriptionPlansVm : builds >

SubscriptionPlansVm "1" *--> "0..*" PlanCardVm : contains >
SubscriptionPlansVm "1" *--> "0..*" FeatureRowVm : contains >
SubscriptionPlansVm "1" *--> "1" SubscriptionStatusVm : contains >

@enduml
