@startuml
skinparam monochrome false
skinparam linetype ortho
skinparam packageStyle rectangle
hide circle

title NutriSmart — Entity Relationship Diagram (derived from JPA entities, nutrismart-platform)

' Convention: every table extends AuditableAbstractPersistenceEntity
'   → id BIGINT <<PK>>, created_at TIMESTAMP, updated_at TIMESTAMP
' user_id / food_id / weather_snapshot_id are application-level references
' (stored as BIGINT, not DB-enforced FKs in code, modelled here as logical FKs).

' ─── IAM ─────────────────────────────────────────────────────────────────────
package "Identity & Access Management" #E8F4FD {
  entity "users" as users {
    * id : BIGINT <<PK>>
    --
    * email : VARCHAR(255) <<UNIQUE>>
    * password_hash : TEXT
    * first_name : VARCHAR
    * last_name : VARCHAR
    * goal : VARCHAR(20)
    * weight : DOUBLE
    * height : DOUBLE
    * activity_level : VARCHAR(20)
    plan : VARCHAR(10)
    restrictions : TEXT
    medical_conditions : TEXT
    * daily_calorie_target : DOUBLE
    * protein_target : DOUBLE
    * carbs_target : DOUBLE
    * fat_target : DOUBLE
    * fiber_target : DOUBLE
    * streak : INT
    * consecutive_misses : INT
    birthday : DATE
    biological_sex : VARCHAR
    home_city : VARCHAR
    goal_started_at : DATE
    plan_expires_at : DATE
  }
  entity "password_reset_tokens" as prt {
    * id : BIGINT <<PK>>
    --
    * token : VARCHAR <<UNIQUE>>
    * user_id : BIGINT <<FK>>
    * expires_at : TIMESTAMP
    * used : BOOLEAN
  }
}

' ─── BEHAVIORAL CONSISTENCY ──────────────────────────────────────────────────
package "Behavioral Consistency" #FDF2E9 {
  entity "behavioral_progress" as bp {
    * id : BIGINT <<PK>>
    --
    * user_id : BIGINT <<FK>> <<UNIQUE>>
    * adherence_status : VARCHAR
    * streak : INT
    * consecutive_misses : INT
    * weekly_completion_rate : DOUBLE
    * last_evaluated_at : TIMESTAMP
  }
  entity "behavioral_progress_goal_met_dates" as bpgmd {
    * behavioral_progress_id : BIGINT <<FK>>
    goal_met_date : DATE
  }
  entity "eating_behavior_patterns" as ebp {
    * id : BIGINT <<PK>>
    --
    * user_id : BIGINT <<FK>> <<UNIQUE>>
    * pattern_type : VARCHAR
    * detected_at : TIMESTAMP
  }
  entity "recovery_plans" as rp {
    * id : BIGINT <<PK>>
    --
    * user_id : BIGINT <<FK>>
    * status : VARCHAR
    * drop_trigger : VARCHAR
    * actions : TEXT
    * expires_at : TIMESTAMP
  }
}

' ─── METABOLIC ADAPTATION ────────────────────────────────────────────────────
package "Metabolic Adaptation" #EAFAF1 {
  entity "body_metrics" as bm {
    * id : BIGINT <<PK>>
    --
    * user_id : BIGINT <<FK>>
    * weight_kg : DOUBLE
    * height_cm : DOUBLE
    logged_at : TIMESTAMP
    target_weight_kg : DOUBLE
    projected_achievement_date : DATE
  }
  entity "body_compositions" as bc {
    * id : BIGINT <<PK>>
    --
    * user_id : BIGINT <<FK>>
    waist_cm : DOUBLE
    neck_cm : DOUBLE
    height_cm : DOUBLE
    weight_kg : DOUBLE
    measured_at : TIMESTAMP
    override_body_fat_percent : DOUBLE
  }
  entity "activity_logs" as al {
    * id : BIGINT <<PK>>
    --
    * user_id : BIGINT <<FK>>
    activity_type : VARCHAR
    * duration_minutes : INT
    * calories_burned : DOUBLE
    timestamp : TIMESTAMP
  }
  entity "wearable_connections" as wc {
    * id : BIGINT <<PK>>
    --
    * user_id : BIGINT <<FK>>
    * provider : VARCHAR
    status : VARCHAR
    last_synced_at : TIMESTAMP
    authorized_at : TIMESTAMP
  }
  entity "metabolic_adaptation_logs" as mal {
    * id : BIGINT <<PK>>
    --
    * user_id : BIGINT <<FK>>
    triggered_by : VARCHAR
    previous_bmr / new_bmr : DOUBLE
    previous_tdee / new_tdee : DOUBLE
    previous/new calories,protein,carbs,fat : DOUBLE
    changed_at : TIMESTAMP
  }
}

' ─── NUTRITION TRACKING ──────────────────────────────────────────────────────
package "Nutrition Tracking" #FEF9E7 {
  entity "foods" as foods {
    * id : BIGINT <<PK>>
    --
    name : VARCHAR
    name_es : VARCHAR
    source : VARCHAR
    serving_size : DOUBLE
    serving_unit : VARCHAR
    restrictions : TEXT
    name_key : VARCHAR <<UNIQUE>>
    category : VARCHAR
    item_type : VARCHAR
    weather_types : TEXT
    origin_city : VARCHAR
    origin_country : VARCHAR
  }
  entity "nutrition_log" as nlog {
    * id : BIGINT <<PK>>
    --
    * user_id : BIGINT <<FK>>
    food_id : BIGINT <<FK>>
    food_item_name : VARCHAR
    meal_type : VARCHAR
    quantity : DOUBLE
    calories : DOUBLE
    protein/carbs/fat/fiber/sugar : DOUBLE
    logged_at : TIMESTAMP
  }
  entity "daily_intake" as di {
    * id : BIGINT <<PK>>
    --
    user_id : BIGINT <<FK>>
    date : DATE
    daily_goal : DOUBLE
    consumed : DOUBLE
    active : DOUBLE
  }
}

' ─── SMART RECOMMENDATION ─────────────────────────────────────────────────────
package "Smart Recommendation" #F4ECF7 {
  entity "pantry" as pantry {
    * id : BIGINT <<PK>>
    --
    * user_id : BIGINT <<FK>>
    * food_id : BIGINT <<FK>>
    * quantity_g : DOUBLE
  }
  entity "recommendation_sessions" as rs {
    * id : BIGINT <<PK>>
    --
    * user_id : BIGINT <<FK>>
    adherence_status : VARCHAR
    consecutive_misses : INT
    simplified_kcal_target : DOUBLE
    * is_active : BOOLEAN
    weather_snapshot_id : BIGINT <<FK>>
  }
  entity "weather_snapshots" as ws {
    * id : BIGINT <<PK>>
    --
    * city : VARCHAR
    country : VARCHAR
    temperature_celsius : DOUBLE
    weather_condition : VARCHAR
    * weather_type : VARCHAR
  }
  entity "travel_contexts" as tc {
    * id : BIGINT <<PK>>
    --
    * user_id : BIGINT <<FK>>
    * city : VARCHAR
    country : VARCHAR
    * is_active : BOOLEAN
    * is_manual : BOOLEAN
    activated_at : TIMESTAMP
  }
  entity "user_location_snapshots" as uls {
    * id : BIGINT <<PK>>
    --
    * user_id : BIGINT <<FK>>
    * city : VARCHAR
    country : VARCHAR
    recorded_at : TIMESTAMP
  }
  entity "recommendation_cards" as rc {
    * id : BIGINT <<PK>>
    --
    badge : VARCHAR
    weather_type : VARCHAR
    travel_city : VARCHAR
    * card_type : VARCHAR
    * food_id : BIGINT <<FK>>
    description : TEXT
    description_es : TEXT
  }
  entity "recipes" as recipes {
    * id : BIGINT <<PK>>
    --
    * name : VARCHAR
    name_es : VARCHAR
    goal_type : VARCHAR
    prep_time_minutes : INT
    estimated_calories : DOUBLE
    estimated_protein/carbs/fat : DOUBLE
    ingredients : TEXT
  }
}

' ─── SUBSCRIPTIONS ───────────────────────────────────────────────────────────
package "Subscriptions" #FADBD8 {
  entity "subscriptions" as subs {
    * id : BIGINT <<PK>>
    --
    * user_id : BIGINT <<FK>> <<UNIQUE>>
    plan : VARCHAR(10)
    status : VARCHAR
    billing_cycle_start : DATE
    billing_cycle_end : DATE
  }
  entity "billing_history" as bh {
    * id : BIGINT <<PK>>
    --
    * user_id : BIGINT <<FK>>
    plan : VARCHAR(10)
    amount : DOUBLE
    currency : VARCHAR
    paid_at : TIMESTAMP
    status : VARCHAR
  }
}

' ─── RELATIONSHIPS (cardinality) ─────────────────────────────────────────────
' 1:N
users ||--o{ prt           : "1:N  has reset tokens"
users ||--o{ recovery_plans : "1:N  follows"
users ||--o{ bm            : "1:N  logs"
users ||--o{ bc            : "1:N  logs"
users ||--o{ al            : "1:N  logs"
users ||--o{ wc            : "1:N  connects"
users ||--o{ mal           : "1:N  recalculations"
users ||--o{ nlog          : "1:N  logs meals"
users ||--o{ di            : "1:N  daily totals"
users ||--o{ pantry        : "1:N  owns"
users ||--o{ rs            : "1:N  sessions"
users ||--o{ tc            : "1:N  travels"
users ||--o{ uls           : "1:N  locations"
users ||--o{ bh            : "1:N  billed"

' 1:1 (user_id UNIQUE)
users ||--|| bp            : "1:1  progress"
users ||--|| ebp           : "1:1  pattern"
users ||--|| subs          : "1:1  subscription"

' element collection
bp ||--o{ bpgmd            : "1:N  goal-met dates"

' food references
foods ||--o{ nlog          : "1:N  logged as"
foods ||--o{ pantry        : "1:N  stocked as"
foods ||--o{ rc            : "1:N  featured in"

' weather reference
ws ||--o{ rs               : "1:N  contextualizes"

note bottom of recipes
  ** recipes has NO foreign key ** in the real schema.
  It is a global, AI-generated catalog filtered by goal_type
  (enum, not a table). Left unconnected per the source code —
  reported separately rather than linked artificially.
end note

note as N1
  Analytics is a read-model bounded context: it has
  NO tables of its own and aggregates data from the
  other contexts via ACL ports at query time.
end note

@enduml
